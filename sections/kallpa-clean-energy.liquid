{%- comment -%}
  SECCIÓN: kallpa-clean-energy.liquid
  Más que café, es energía natural (Filosofía KALPA VRAEM)
{%- endcomment -%}

<section class="kallpa-energy-natural-section" id="energy-natural-section" aria-label="Cafeína de la tierra, no de laboratorio">
  <div class="energy-natural__bg-layer" aria-hidden="true"></div>
  <div class="energy-natural__container">
    
    <!-- Mensaje y Filosofía de Origen -->
    <div class="energy-natural__content">
      <div class="energy-natural__accent-bar" aria-hidden="true"></div>
      <h2 class="energy-natural__title">
        <span class="energy-title-line1">{{ section.settings.title_line1 | default: 'CAFEÍNA DE LA TIERRA,' }}</span>
        <span class="energy-title-line2">{{ section.settings.title_line2 | default: 'NO DE LABORATORIO' }}</span>
      </h2>
      {%- if section.settings.desc != blank -%}
        <p class="energy-natural__text">{{ section.settings.desc }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <!-- Comparativa editable: cada fila es un bloque de la sección -->
        <div class="energy-compare">
          <div class="energy-compare__scroll">
            <table class="energy-compare__table">
              <thead>
                <tr>
                  <td></td>
                  <th scope="col" class="energy-compare__brand">{{ section.settings.compare_head_brand }}</th>
                  <th scope="col">{{ section.settings.compare_head_other }}</th>
                </tr>
              </thead>
              <tbody>
                {%- for block in section.blocks -%}
                  <tr {{ block.shopify_attributes }}>
                    <th scope="row">{{ block.settings.label }}</th>
                    <td class="energy-compare__brand">{{ block.settings.kalpa }}</td>
                    <td>{{ block.settings.other }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
          {%- if section.settings.compare_note != blank -%}
            <p class="energy-compare__note">{{ section.settings.compare_note }}</p>
          {%- endif -%}
          {%- if section.settings.compare_cta_text != blank -%}
            <a href="{{ section.settings.compare_cta_url | default: routes.all_products_collection_url }}" class="energy-compare__cta">
              <span>{{ section.settings.compare_cta_text }}</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Energía Natural KALPA",
  "settings": [
    {
      "type": "text",
      "id": "title_line1",
      "label": "Título Línea 1",
      "default": "CAFEÍNA DE LA TIERRA,"
    },
    {
      "type": "text",
      "id": "title_line2",
      "label": "Título Línea 2 (Dorado)",
      "default": "NO DE LABORATORIO"
    },
    {
      "type": "textarea",
      "id": "desc",
      "label": "Texto Filosofía"
    },
    {
      "type": "header",
      "content": "Tabla comparativa"
    },
    {
      "type": "text",
      "id": "compare_head_brand",
      "label": "Columna de la marca",
      "default": "KALPA"
    },
    {
      "type": "text",
      "id": "compare_head_other",
      "label": "Columna de comparación",
      "default": "OTRAS BEBIDAS ENERGÉTICAS"
    },
    {
      "type": "text",
      "id": "compare_note",
      "label": "Nota al pie",
      "default": "*En sus versiones regulares; puede variar según la marca."
    },
    {
      "type": "text",
      "id": "compare_cta_text",
      "label": "Texto del botón",
      "default": "PRUÉBALA"
    },
    {
      "type": "url",
      "id": "compare_cta_url",
      "label": "Enlace del botón",
      "info": "Si lo dejas vacío, lleva a la tienda"
    }
  ],
  "blocks": [
    {
      "type": "compare_row",
      "name": "Fila de la tabla",
      "settings": [
        { "type": "text", "id": "label", "label": "Concepto", "default": "Cafeína" },
        { "type": "text", "id": "kalpa", "label": "KALPA", "default": "Natural" },
        { "type": "text", "id": "other", "label": "Otras bebidas", "default": "Sintética" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Energía Natural KALPA"
    }
  ]
}
{% endschema %}
