{%- comment -%}
  SECCIÓN: header.liquid
  Header y Barra de Anuncios Oficial KALPA (Pixel-Perfect con Mockup)
{%- endcomment -%}

<!-- 1. Barra Superior de Anuncios Amarillo Oro -->
<div class="kalpa-announcement-bar">
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="announcement-truck-icon">
    <rect x="1" y="3" width="15" height="13"></rect>
    <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
    <circle cx="5.5" cy="18.5" r="2.5"></circle>
    <circle cx="18.5" cy="18.5" r="2.5"></circle>
  </svg>
  <span>{{ section.settings.announcement_text | default: 'Envíos a todo el Perú.' }}</span>
  <a href="{{ section.settings.announcement_link | default: '#products-section' }}" class="announcement-link-desktop">{{ section.settings.announcement_link_text | default: 'Ver promoción de lanzamiento' }}</a>
</div>

<!-- 2. Barra de Navegación Negra -->
<header class="kalpa-navbar" id="kallpa-header">
  <div class="page-width kalpa-navbar__container">
    
    <!-- Logo KALPA Oficial -->
    <a href="/" class="kalpa-logo" aria-label="KALPA Cold Brew - Inicio">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 280 }}" alt="{{ shop.name }}" class="kalpa-logo__img" width="130" height="30" />
      {%- else -%}
        <img src="{{ 'logo-kalpa-white.png' | asset_url }}" alt="KALPA Logo" class="kalpa-logo__img" width="130" height="30" />
      {%- endif -%}
    </a>

    <!-- Menú Central -->
    <nav class="kalpa-nav-menu">
      <a href="#hero-section" class="kalpa-nav-item is-active">Inicio</a>
      <a href="#products-section" class="kalpa-nav-item">Productos</a>
      <a href="#showcase-section" class="kalpa-nav-item">Tienda</a>
      <a href="#features-section" class="kalpa-nav-item">Promociones</a>
      <a href="#footer-section" class="kalpa-nav-item">Nosotros</a>
    </nav>

    <!-- Acciones Derecha (Búsqueda, Cuenta, Wishlist, Carrito, Hamburger) -->
    <div class="kalpa-nav-actions">
      <!-- Búsqueda -->
      <button type="button" class="kalpa-nav-icon nav-icon--search" aria-label="Buscar">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <!-- Carrito Cápsula -->
      <button type="button" class="kalpa-cart-capsule" onclick="openKallpaCart()" aria-label="Abrir Carrito">
        <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span id="kallpa-cart-count">0</span>
      </button>

      <!-- Cuenta de Usuario -->
      <a href="/account" class="kalpa-nav-icon nav-icon--account" aria-label="Mi Cuenta">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </a>

      <!-- Lista de Deseos (Wishlist) -->
      <button type="button" class="kalpa-nav-icon nav-icon--favorites" aria-label="Lista de Deseos">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
      </button>

      <!-- Botón de Menú Hamburguesa Móvil -->
      <button type="button" class="kalpa-nav-hamburger" id="kalpa-mobile-menu-btn" aria-label="Abrir Menú">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>

  </div>
</header>

{% schema %}
{
  "name": "Header KALPA",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Texto de la Barra de Anuncios",
      "default": "Envíos a todo el Perú. Compra por unidad o por pack."
    },
    {
      "type": "text",
      "id": "announcement_link_text",
      "label": "Texto del Enlace",
      "default": "Ver promoción de lanzamiento"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Enlace del Anuncio"
    }
  ]
}
{% endschema %}
