{%- comment -%}
  SECCIÓN: header.liquid
  Header y Barra de Anuncios Oficial KALPA (Pixel-Perfect con Mockup)
{%- endcomment -%}

<!-- 1. Barra Superior de Anuncios Amarillo Oro -->
<div class="kalpa-announcement-bar">
  <span>{{ section.settings.announcement_text | default: 'Envíos a todo el Perú. Compra por unidad o por pack.' }}</span>
  <a href="{{ section.settings.announcement_link | default: '#products-section' }}">{{ section.settings.announcement_link_text | default: 'Ver promoción de lanzamiento' }}</a>
</div>

<!-- 2. Barra de Navegación Negra -->
<header class="kalpa-navbar" id="kallpa-header">
  <div class="page-width kalpa-navbar__container">
    
    <!-- Logo KALPA -->
    <a href="/" class="kalpa-logo">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
      </svg>
      <span>KALPA</span>
    </a>

    <!-- Menú Central -->
    <nav class="kalpa-nav-menu">
      <a href="#hero-section" class="kalpa-nav-item is-active">Inicio</a>
      <a href="#products-section" class="kalpa-nav-item">Productos</a>
      <a href="#showcase-section" class="kalpa-nav-item">Tienda</a>
      <a href="#features-section" class="kalpa-nav-item">Promociones</a>
      <a href="#footer-section" class="kalpa-nav-item">Nosotros</a>
    </nav>

    <!-- Acciones Derecha (Búsqueda, Cuenta, Wishlist, Carrito) -->
    <div class="kalpa-nav-actions">
      <!-- Búsqueda -->
      <button type="button" class="kalpa-nav-icon" aria-label="Buscar">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <!-- Cuenta de Usuario -->
      <a href="/account" class="kalpa-nav-icon" aria-label="Mi Cuenta">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </a>

      <!-- Lista de Deseos (Wishlist) -->
      <button type="button" class="kalpa-nav-icon" aria-label="Lista de Deseos">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
      </button>

      <!-- Carrito Cápsula -->
      <button type="button" class="kalpa-cart-capsule" onclick="openKallpaCart()" aria-label="Abrir Carrito">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span id="kallpa-cart-count">0</span>
      </button>
    </div>

  </div>
</header>

{% schema %}
{
  "name": "Header KALPA",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Texto de la Barra de Anuncios",
      "default": "Envíos a todo el Perú. Compra por unidad o por pack."
    },
    {
      "type": "text",
      "id": "announcement_link_text",
      "label": "Texto del Enlace",
      "default": "Ver promoción de lanzamiento"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Enlace del Anuncio"
    }
  ]
}
{% endschema %}
