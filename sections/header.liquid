{%- comment -%}
  SECCIÓN: header.liquid
  Header Global Glassmorphic Oficial KALPA con Navegación Centrada y Drawer Móvil
{%- endcomment -%}

<!-- 1. Barra Superior de Anuncios Amarillo Oro -->
{%- if section.settings.show_announcement -%}
<div class="kalpa-announcement-bar">
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="announcement-truck-icon">
    <rect x="1" y="3" width="15" height="13"></rect>
    <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
    <circle cx="5.5" cy="18.5" r="2.5"></circle>
    <circle cx="18.5" cy="18.5" r="2.5"></circle>
  </svg>
  <span>{{ section.settings.announcement_text | default: 'Envíos a todo el Perú. Compra por unidad o por pack.' }}</span>
  <a href="{{ section.settings.announcement_link | default: '/pages/promociones' }}" class="announcement-link-desktop">
    {{ section.settings.announcement_link_text | default: 'Ver promoción de lanzamiento' }}
  </a>
</div>
{%- endif -%}

<!-- 2. Barra de Navegación Negra -->
<header class="kalpa-navbar kalpa-nav-header" id="kallpa-header">
  <div class="page-width kalpa-navbar__container">
    
    <!-- Logo KALPA Oficial -->
    <a href="{{ routes.root_url }}" class="kalpa-logo" aria-label="KALPA Cold Brew - Inicio">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 320 }}" alt="{{ shop.name }}" class="kalpa-logo__img" width="165" height="38" />
      {%- else -%}
        <img src="{{ 'logo-kalpa-white.png' | asset_url }}" alt="KALPA Logo" class="kalpa-logo__img" width="165" height="38" />
      {%- endif -%}
    </a>

    <!-- Menú Central Rigurosamente Centrado al 50% -->
    <nav class="kalpa-nav-menu" aria-label="Navegación principal">
      {%- comment -%} Con "Usar el menú del admin" activo, los enlaces salen de Tienda online → Navegación {%- endcomment -%}
      {%- assign nav_menu = linklists[section.settings.menu] -%}
      {%- if section.settings.use_admin_menu and nav_menu.links.size > 0 -%}
        {%- for link in nav_menu.links -%}
          <a href="{{ link.url }}" class="kalpa-nav-item{% if link.active or link.child_active %} is-active{% endif %}">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="{{ routes.root_url }}" class="kalpa-nav-item{% if template.name == 'index' or request.path == routes.root_url %} is-active{% endif %}">Inicio</a>
        <a href="{{ routes.all_products_collection_url }}" class="kalpa-nav-item{% if template.name == 'collection' or request.path contains 'collections' or request.path contains 'tienda' or page.handle contains 'tienda' %} is-active{% endif %}">Tienda</a>
        <a href="/pages/productos" class="kalpa-nav-item{% if template.name == 'page' and page.handle contains 'producto' or request.path contains 'productos' %} is-active{% endif %}">Productos</a>
        <a href="/pages/promociones" class="kalpa-nav-item{% if request.path contains 'promociones' %} is-active{% endif %}">Promociones</a>
        <a href="/pages/nosotros" class="kalpa-nav-item{% if template.name == 'page' and page.handle contains 'nosotros' or page.handle contains 'contact' or request.path contains 'nosotros' or request.path contains 'contact' %} is-active{% endif %}">Nosotros</a>
      {%- endif -%}
    </nav>

    <!-- Acciones Derecha (Búsqueda, Cuenta, Wishlist, Carrito, CTA, Hamburger) -->
    <div class="kalpa-nav-actions">
      <!-- Cuenta de Usuario -->
      <a href="{{ routes.account_url }}" class="kalpa-nav-icon nav-icon--account" aria-label="Mi Cuenta">
        <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </a>

      <!-- Búsqueda -->
      <button type="button" class="kalpa-nav-icon nav-icon--search" aria-label="Buscar productos" aria-controls="kallpa-search" aria-expanded="false" onclick="openKallpaSearch(this)">
        <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <!-- Carrito Cápsula -->
      <button type="button" class="kalpa-cart-capsule" onclick="openKallpaCart()" aria-label="Abrir Carrito">
        <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span id="kallpa-cart-count">{{ cart.item_count }}</span>
      </button>

      <!-- Botón Comprar Ahora -->
      <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="kalpa-nav-cta">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="8" cy="21" r="1"></circle>
          <circle cx="19" cy="21" r="1"></circle>
          <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
        </svg>
        <span>{{ section.settings.cta_text | default: 'COMPRAR AHORA' }}</span>
      </a>

      <!-- Botón de Menú Hamburguesa Móvil -->
      <button type="button" class="kalpa-nav-hamburger" id="kalpa-mobile-menu-btn" aria-label="Abrir Menú" onclick="openKallpaMobileMenu()">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>

  </div>
</header>

<!-- Drawer Móvil Deslizante Global -->
<div id="kalpa-mobile-menu-drawer" class="kalpa-mobile-menu-drawer" aria-hidden="true">
  <div class="kalpa-mobile-menu-overlay" onclick="closeKallpaMobileMenu()"></div>
  <div class="kalpa-mobile-menu-content">
    <div class="kalpa-mobile-menu-header">
      <a href="{{ routes.root_url }}" class="kalpa-logo" aria-label="KALPA - Inicio">
        <img src="{{ 'logo-kalpa-white.png' | asset_url }}" alt="KALPA Logo" class="kalpa-logo__img" width="135" height="32" />
      </a>
      <button type="button" class="kalpa-mobile-menu-close" onclick="closeKallpaMobileMenu()" aria-label="Cerrar Menú">✕</button>
    </div>
    <nav class="kalpa-mobile-menu-links">
      {%- if section.settings.use_admin_menu and nav_menu.links.size > 0 -%}
        {%- for link in nav_menu.links -%}
          <a href="{{ link.url }}" class="kalpa-mobile-item{% if link.active or link.child_active %} is-active{% endif %}" onclick="closeKallpaMobileMenu()">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="{{ routes.root_url }}" class="kalpa-mobile-item{% if template.name == 'index' or request.path == routes.root_url %} is-active{% endif %}" onclick="closeKallpaMobileMenu()">Inicio</a>
        <a href="{{ routes.all_products_collection_url }}" class="kalpa-mobile-item{% if template.name == 'collection' or request.path contains 'collections' or request.path contains 'tienda' or page.handle contains 'tienda' %} is-active{% endif %}" onclick="closeKallpaMobileMenu()">Tienda</a>
        <a href="/pages/productos" class="kalpa-mobile-item{% if template.name == 'page' and page.handle contains 'producto' or request.path contains 'productos' %} is-active{% endif %}" onclick="closeKallpaMobileMenu()">Productos</a>
        <a href="/pages/promociones" class="kalpa-mobile-item{% if request.path contains 'promociones' %} is-active{% endif %}" onclick="closeKallpaMobileMenu()">Promociones</a>
        <a href="/pages/nosotros" class="kalpa-mobile-item{% if template.name == 'page' and page.handle contains 'nosotros' or page.handle contains 'contact' or request.path contains 'nosotros' or request.path contains 'contact' %} is-active{% endif %}" onclick="closeKallpaMobileMenu()">Nosotros</a>
      {%- endif -%}
    </nav>
    <div class="kalpa-mobile-menu-footer">
      <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="kalpa-nav-cta kalpa-mobile-cta" onclick="closeKallpaMobileMenu()">
        <span>{{ section.settings.cta_text | default: 'COMPRAR AHORA' }}</span>
      </a>
    </div>
  </div>
</div>

<!-- Buscador (abre desde la lupa del header) -->
<div class="kallpa-search" id="kallpa-search" hidden>
  <div class="kallpa-search__backdrop" onclick="closeKallpaSearch()"></div>
  <form action="{{ routes.search_url }}" method="get" role="search" class="kallpa-search__form">
    <input type="hidden" name="type" value="product">
    <label for="kallpa-search-input" class="visually-hidden">Buscar productos</label>
    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
    <input id="kallpa-search-input" type="search" name="q" placeholder="Buscar café, cold brew, packs…" autocomplete="off" value="{{ search.terms | escape }}">
    <button type="submit" class="kallpa-search__submit">BUSCAR</button>
    <button type="button" class="kallpa-search__close" onclick="closeKallpaSearch()" aria-label="Cerrar búsqueda">✕</button>
  </form>
</div>

<style>
  .kallpa-search { position: fixed; inset: 0; z-index: 1200; }
  .kallpa-search[hidden] { display: none; }
  .kallpa-search__backdrop { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(4px); }
  .kallpa-search__form { position: relative; display: flex; align-items: center; gap: 0.75rem; max-width: 760px; margin: clamp(5rem, 14vh, 9rem) auto 0; padding: 0.6rem 0.6rem 0.6rem 1.25rem; border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 999px; background: #0d0f12; color: #fff; box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5); width: calc(100% - 2rem); }
  .kallpa-search__form > svg { flex-shrink: 0; color: #f5ba2c; }
  .kallpa-search__form input[type="search"] { flex: 1; min-width: 0; border: 0; background: transparent; color: #fff; font: inherit; font-size: 1.05rem; outline: none; }
  .kallpa-search__submit { padding: 0.75rem 1.4rem; border: 0; border-radius: 999px; background: #f5ba2c; color: #0b0908; font-family: var(--font-brand); font-weight: 900; letter-spacing: 0.06em; cursor: pointer; }
  .kallpa-search__close { width: 40px; height: 40px; border: 0; border-radius: 50%; background: rgba(255, 255, 255, 0.08); color: #fff; cursor: pointer; }
  @media (max-width: 520px) { .kallpa-search__submit { display: none; } }
</style>

<script>
  function openKallpaSearch(btn) {
    var box = document.getElementById('kallpa-search');
    if (!box) return;
    box.hidden = false;
    if (btn) btn.setAttribute('aria-expanded', 'true');
    var input = document.getElementById('kallpa-search-input');
    if (input) setTimeout(function() { input.focus(); }, 30);
  }
  function closeKallpaSearch() {
    var box = document.getElementById('kallpa-search');
    if (box) box.hidden = true;
    document.querySelectorAll('.nav-icon--search').forEach(function(b) { b.setAttribute('aria-expanded', 'false'); });
  }
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeKallpaSearch(); });
</script>

{% schema %}
{
  "name": "Header KALPA",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Mostrar Barra de Anuncios",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Texto del Anuncio",
      "default": "Envíos a todo el Perú. Compra por unidad o por pack."
    },
    {
      "type": "text",
      "id": "announcement_link_text",
      "label": "Texto del Enlace del Anuncio",
      "default": "Ver promoción de lanzamiento"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Enlace del Anuncio"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Personalizado"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú de Navegación",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "use_admin_menu",
      "label": "Usar el menú del admin",
      "info": "Activa esto cuando el menú elegido arriba tenga los enlaces finales (Tienda online → Navegación). Desactivado, se muestran Inicio, Tienda, Productos, Promociones y Nosotros.",
      "default": false
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Texto Botón CTA",
      "default": "COMPRAR AHORA"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Enlace Botón CTA"
    }
  ]
}
{% endschema %}
