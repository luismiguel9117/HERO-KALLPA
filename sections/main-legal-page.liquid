{%- comment -%}
  SECCIÓN: main-legal-page.liquid
  Términos, Privacidad, Cambios y Devoluciones y Libro de Reclamaciones. El contenido vive en
  snippets/legal-page.liquid; aquí solo están los datos editables de la empresa.
{%- endcomment -%}

{% render "legal-page", legal: section.settings %}

{% schema %}
{
  "name": "Página Legal KALPA",
  "settings": [
    {
      "type": "header",
      "content": "Datos de la empresa"
    },
    {
      "type": "text",
      "id": "company_name",
      "label": "Razón social",
      "default": "Kallpa Origins Labs"
    },
    {
      "type": "text",
      "id": "company_ruc",
      "label": "RUC",
      "default": "20616530683"
    },
    {
      "type": "text",
      "id": "company_address",
      "label": "Domicilio fiscal",
      "default": "Urb. Mariscal Cáceres Mz G Lt 5, Ayacucho, Perú"
    },
    {
      "type": "text",
      "id": "company_city",
      "label": "Ciudad (encabezado)",
      "default": "Ayacucho, Perú"
    },
    {
      "type": "text",
      "id": "support_email",
      "label": "Correo de atención",
      "default": "ventas@kalpa.pe",
      "info": "Las hojas de reclamación llegan al correo de la tienda (Configuración → General)."
    }
  ]
}
{% endschema %}