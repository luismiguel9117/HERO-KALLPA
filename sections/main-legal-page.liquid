  }

  .kallpa-breadcrumbs a:hover {
    color: #fbd132;
  }

  .bc-sep {
    color: rgba(255, 255, 255, 0.3);
  }

  .bc-current {
    color: #fbd132;
  }

  .kallpa-legal-hero__title {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0 0 0.65rem;
    text-transform: uppercase;
  }

  .kallpa-legal-hero__subtitle {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  /* Grid Layout */
  .kallpa-legal-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding-top: 3.5rem;
