<script>
  (function initLegalPage() {
    function getDocFromUrl() {
      var p = window.location.pathname.toLowerCase();
      if (p.includes('privacidad') || p.includes('privacy')) return 'privacidad';
      if (p.includes('devolucion') || p.includes('cambio') || p.includes('envio') || p.includes('returns')) return 'devoluciones';
      if (p.includes('reclamacion') || p.includes('libro')) return 'reclamaciones';
      return 'terminos';
    }

    function updateView() {
      var doc = getDocFromUrl();
      
      // Mostrar artículo correspondiente
      var articles = document.querySelectorAll('[data-legal-doc]');
      articles.forEach(function(a) {
        if (a.getAttribute('data-legal-doc') === doc) {
          a.style.display = 'block';
        } else {
          a.style.display = 'none';
        }
      });

      // Actualizar enlace activo en sidebar
      var navLinks = document.querySelectorAll('.legal-nav-link');
      navLinks.forEach(function(l) {
        if (l.getAttribute('data-doc-target') === doc) {
          l.classList.add('is-active');
        } else {
          l.classList.remove('is-active');
        }
      });

      // Actualizar título del hero
      var titleEl = document.getElementById('legalHeroTitle');
      if (titleEl) {
        if (doc === 'privacidad') {
          titleEl.innerHTML = 'POLÍTICA DE <span class="text-gold">PRIVACIDAD</span>';
          document.title = 'Política de Privacidad | KALPA';
        } else if (doc === 'devoluciones') {
          titleEl.innerHTML = 'CAMBIOS Y <span class="text-gold">DEVOLUCIONES</span>';
          document.title = 'Cambios y Devoluciones | KALPA';
        } else if (doc === 'reclamaciones') {
          titleEl.innerHTML = 'LIBRO DE <span class="text-gold">RECLAMACIONES</span>';
          document.title = 'Libro de Reclamaciones | KALPA';
        } else {
          titleEl.innerHTML = 'TÉRMINOS Y <span class="text-gold">CONDICIONES</span>';
          document.title = 'Términos y Condiciones | KALPA';
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', updateView);
    } else {
      updateView();
    }
  })();

  function handleHojaSubmit(e, form) {
    e.preventDefault();
    const successBox = document.getElementById('hojaSuccessMsg');
    if (form && successBox) {
      form.style.display = 'none';
      successBox.style.display = 'block';
      if (typeof window.showKallpaToast === 'function') {
        window.showKallpaToast('Hoja de reclamación registrada bajo el código REC-2026-0842.');
      }
    }
  }
</script>

