    position: relative;
    padding: 7rem 0 3.5rem;
    background: #080c10;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .kallpa-legal-hero__bg {
    position: absolute;
    inset: 0;
    background-image: url('{{ "kalpa-hero-bg.webp" | asset_url }}');
