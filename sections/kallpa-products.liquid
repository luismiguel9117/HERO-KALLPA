{%- comment -%}
  SECCIÓN: kallpa-products.liquid
  Sección de Venta Directa KALPA ORIGINAL (Unidad S/ 7.90 y Pack x 6 S/ 39.90 -15%)
{%- endcomment -%}

<section class="kalpa-product-showcase-sale" id="products-section">
  <div class="page-width kalpa-sale-container">
    <div class="kalpa-sale-grid">
      
      <!-- Columna 1: Información Editorial y 4 Sellos Circulares -->
      <div class="kalpa-sale__info">
        <span class="sale-top-line"></span>
        <span class="sale-eyebrow">{{ section.settings.eyebrow | default: 'NUESTRO PRODUCTO' }}</span>
        <h2 class="sale-giant-title">
          <span class="sale-title-main">{{ section.settings.title_part1 | default: 'KALPA' }}</span>
          <span class="sale-title-sub">{{ section.settings.title_part2 | default: 'ORIGINAL' }}</span>
        </h2>
        <p class="sale-description">
          Café cold brew de origen peruano, hecho con granos del VRAEM. Listo para tomar, en cualquier momento y lugar.
        </p>

        <!-- 4 Iconos de Atributos Circulares -->
        <div class="sale-features-row">
          <div class="sale-feature-badge">
            <div class="sale-feature-circle">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
              </svg>
              <span class="drop-zero">0</span>
            </div>
            <span class="sale-feature-label">CALORÍAS</span>
          </div>

          <div class="sale-feature-badge">
            <div class="sale-feature-circle">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
                <line x1="4" y1="4" x2="20" y2="20"></line>
              </svg>
            </div>
            <span class="sale-feature-label">SIN AZÚCARES<br>AÑADIDOS</span>
          </div>

          <div class="sale-feature-badge">
            <div class="sale-feature-circle">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="6" y="4" width="10" height="17" rx="2"></rect>
                <path d="M16 8h2a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2"></path>
                <line x1="8" y1="2" x2="14" y2="2"></line>
              </svg>
            </div>
            <span class="sale-feature-label">LISTO<br>PARA TOMAR</span>
          </div>

          <div class="sale-feature-badge">
            <div class="sale-feature-circle">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <line x1="12" y1="2" x2="12" y2="22"></line>
                <path d="m20 16-4-4 4-4"></path>
                <path d="m4 8 4 4-4 4"></path>
                <path d="m16 4-4 4-4-4"></path>
                <path d="m8 20 4-4 4 4"></path>
              </svg>
            </div>
            <span class="sale-feature-label">COLD BREW<br>REFRESCANTE</span>
          </div>
        </div>
      </div>

      <!-- Columna 2: Composición Central (Lata + Hielos + Granos + Piedra Volcánica) -->
      <div class="kalpa-sale__centerpiece">
        <div class="sale-can-stage">
          <img src="{{ 'hero-beans-ice-back.png' | asset_url }}" alt="" class="sale-stage__beans-back" draggable="false" />
          <img src="{{ 'hero-beans-ice-front.png' | asset_url }}" alt="" class="sale-stage__beans-mid" draggable="false" />
          <img src="{{ 'kalpa-can-original.png' | asset_url }}" alt="KALPA Café Cold Brew Original 355ml" class="sale-stage__can" draggable="false" />
          <img src="{{ 'hero-bean-single.png' | asset_url }}" alt="" class="sale-stage__bean-front" draggable="false" />
          <img src="{{ 'hero-rock-base.png' | asset_url }}" alt="" class="sale-stage__rock" draggable="false" />
        </div>
      </div>

      <!-- Columna 3: Tarjeta Dual de Compra (Unidad y Pack x 6) -->
      <div class="kalpa-sale__buy-box">
        <div class="sale-buy-col sale-buy-col--unit">
          <div class="sale-unit-header">Unidad</div>
          <div class="sale-price-block">
            <div class="sale-price-main">S/ 7.90</div>
            <div class="sale-volume-sub">355 ml</div>
          </div>
          <div class="sale-qty-stepper" aria-label="Cantidad de unidades">
            <button type="button" class="qty-btn" onclick="updateSaleUnitQty(-1)" aria-label="Disminuir cantidad">&minus;</button>
            <span id="sale-unit-qty" class="qty-val">1</span>
            <button type="button" class="qty-btn" onclick="updateSaleUnitQty(1)" aria-label="Aumentar cantidad">+</button>
          </div>
          <button type="button" class="btn-sale-add" onclick="addSaleUnitToCart()">
            <span>AGREGAR</span>
            <svg class="sale-add-arrow-mobile" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </div>

        <div class="sale-buy-col sale-buy-col--pack">
          <div class="sale-pack-header">
            <span class="sale-pack-title">Pack x 6</span>
            <span class="sale-pack-discount">-15%</span>
          </div>
          <div class="sale-pack-body">
            <div class="sale-pack-pricing">
              <span class="sale-pack-old-price">S/ 47.40</span>
              <div class="sale-price-main sale-price-main--pack">S/ 39.90</div>
              <div class="sale-volume-sub">6 latas de 355 ml</div>
            </div>
            <div class="sale-pack-cans-visual" aria-hidden="true">
              <img src="{{ 'kalpa-can-original.png' | asset_url }}" alt="" class="pack-mini-can pack-mini-can--b1" draggable="false" />
              <img src="{{ 'kalpa-can-original.png' | asset_url }}" alt="" class="pack-mini-can pack-mini-can--b2" draggable="false" />
              <img src="{{ 'kalpa-can-original.png' | asset_url }}" alt="" class="pack-mini-can pack-mini-can--b3" draggable="false" />
              <img src="{{ 'kalpa-can-original.png' | asset_url }}" alt="" class="pack-mini-can pack-mini-can--f1" draggable="false" />
              <img src="{{ 'kalpa-can-original.png' | asset_url }}" alt="" class="pack-mini-can pack-mini-can--f2" draggable="false" />
              <img src="{{ 'kalpa-can-original.png' | asset_url }}" alt="" class="pack-mini-can pack-mini-can--f3" draggable="false" />
            </div>
          </div>
          <button type="button" class="btn-sale-add" onclick="addPackToKallpaCart('pack-6-original', 'Pack x 6 KALPA Original (6x355ml)', 39.90)">
            <span>AGREGAR</span>
          </button>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Productos KALPA",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "NUESTROS PRODUCTOS"
    },
    {
      "type": "text",
      "id": "title_part1",
      "label": "Título Parte 1",
      "default": "ELIGE CUÁNTA"
    },
    {
      "type": "text",
      "id": "title_part2",
      "label": "Título Parte 2 (Dorado)",
      "default": "ENERGÍA LLEVAS"
    }
  ]
}
{% endschema %}
