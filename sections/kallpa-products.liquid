{%- comment -%}
  SECCIÓN: kallpa-products.liquid
  Carrusel Interactivo de Venta Directa KALPA (Slide 1: Lata 355ml, Slide 2: Molido 250g)
{%- endcomment -%}

<section class="kalpa-product-showcase-sale" id="products-section" aria-label="Nuestros Productos">
  
  <!-- Carousel Track Wrapper -->
  <div class="kalpa-product-carousel" id="kalpaProductCarousel">
    
    <!-- Flechas de navegación -->
    <button type="button" class="carousel-arrow carousel-arrow--prev" onclick="prevProductSlide()" aria-label="Producto anterior">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <button type="button" class="carousel-arrow carousel-arrow--next" onclick="nextProductSlide()" aria-label="Producto siguiente">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>

    <!-- Slides Container -->
    <div class="kalpa-product-carousel-track">

      <!-- ================= SLIDE 1: KALPA ORIGINAL ================= -->
      <div class="kalpa-product-slide kalpa-product-slide--original active" id="product-slide-0" data-slide-index="0">
        <div class="page-width kalpa-sale-container">
          <div class="kalpa-sale-grid">
            
            <!-- Columna 1: Información Editorial y 4 Sellos Circulares -->
            <div class="kalpa-sale__info">
              <span class="sale-top-line"></span>
              <span class="sale-eyebrow">{{ section.settings.slide1_eyebrow | default: 'NUESTRO PRODUCTO' }}</span>
              <h2 class="sale-giant-title">
                <span class="sale-title-main">{{ section.settings.slide1_title_main | default: 'KALPA' }}</span>
                <span class="sale-title-sub">{{ section.settings.slide1_title_sub | default: 'ORIGINAL' }}</span>
              </h2>
              <p class="sale-description">
                {{ section.settings.slide1_desc | default: 'Café cold brew de origen peruano, hecho con granos del VRAEM. 280 mg de cafeína natural. Listo para tomar, en cualquier momento y lugar.' }}
              </p>
              <div style="margin: 0.4rem 0 1rem;">
                <a href="{{ section.settings.slide1_link | default: '/products/kalpa-cold-brew' }}" style="display: inline-flex; align-items: center; gap: 0.45rem; color: #fbd132; font-family: var(--font-brand); font-size: 0.78rem; font-weight: 900; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; transition: opacity 0.2s;">
                  <span>Ver ficha completa</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </a>
              </div>

              <!-- 4 Iconos de Atributos Circulares -->
              <div class="sale-features-row">
                <div class="sale-feature-badge">
                  <div class="sale-feature-circle">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
                    </svg>
                    <span class="drop-zero">0</span>
                  </div>
                  <span class="sale-feature-label">CALORÍAS</span>
                </div>

                <div class="sale-feature-badge">
                  <div class="sale-feature-circle">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
                      <line x1="4" y1="4" x2="20" y2="20"></line>
                    </svg>
                  </div>
                  <span class="sale-feature-label">SIN AZÚCARES<br>AÑADIDOS</span>
                </div>

                <div class="sale-feature-badge">
                  <div class="sale-feature-circle">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="6" y="4" width="10" height="17" rx="2"></rect>
                      <path d="M16 8h2a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2"></path>
                      <line x1="8" y1="2" x2="14" y2="2"></line>
                    </svg>
                  </div>
                  <span class="sale-feature-label">LISTO<br>PARA TOMAR</span>
                </div>

                <div class="sale-feature-badge">
                  <div class="sale-feature-circle">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="2" y1="12" x2="22" y2="12"></line>
                      <line x1="12" y1="2" x2="12" y2="22"></line>
                      <path d="m20 16-4-4 4-4"></path>
                      <path d="m4 8 4 4-4 4"></path>
                      <path d="m16 4-4 4-4-4"></path>
                      <path d="m8 20 4-4 4 4"></path>
                    </svg>
                  </div>
                  <span class="sale-feature-label">COLD BREW<br>REFRESCANTE</span>
                </div>
              </div>
            </div>

            <!-- Columna 2: Composición Central Integrada -->
            <div class="kalpa-sale__centerpiece">
              <div class="sale-can-stage">
                <img src="{{ 'hero-beans-ice-back.png' | asset_url }}" alt="" class="sale-stage__beans-back" draggable="false" width="500" height="500">
                <img src="{{ 'hero-beans-ice-front.png' | asset_url }}" alt="" class="sale-stage__beans-mid" draggable="false" width="500" height="500">
                <img src="{{ 'kalpa-can-original.png' | asset_url }}" alt="KALPA Café Cold Brew Original 355ml" class="sale-stage__can" draggable="false" width="400" height="700">
                <img src="{{ 'hero-bean-single.png' | asset_url }}" alt="" class="sale-stage__bean-front" draggable="false" width="70" height="70">
                <img src="{{ 'hero-rock-base.png' | asset_url }}" alt="" class="sale-stage__rock" draggable="false" width="500" height="200">
              </div>
            </div>

            <!-- Columna 3: Tarjeta Dual de Compra -->
            <div class="kalpa-sale__buy-box">
              <!-- Opción A: Compra por Unidad -->
              <div class="sale-buy-col sale-buy-col--unit">
                <div class="sale-unit-header">Unidad</div>
                <div class="sale-price-block">
                  <div class="sale-price-main">S/ 7.90</div>
                  <div class="sale-volume-sub">355 ml</div>
                </div>
                <div class="sale-qty-stepper" aria-label="Cantidad de unidades">
                  <button type="button" class="qty-btn" onclick="updateSaleUnitQty(-1)" aria-label="Disminuir cantidad">&minus;</button>
                  <span id="sale-unit-qty" class="qty-val">1</span>
                  <button type="button" class="qty-btn" onclick="updateSaleUnitQty(1)" aria-label="Aumentar cantidad">+</button>
                </div>
                <button type="button" class="btn-sale-add" onclick="addSaleUnitToCart()">
                  <span>AGREGAR</span>
                  <svg class="sale-add-arrow-mobile" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </button>
              </div>

              <!-- Opción B: Compra Pack x 6 (-15%) -->
              <div class="sale-buy-col sale-buy-col--pack">
                <div class="sale-pack-header">
                  <span class="sale-pack-title">Pack x 6</span>
                  <span class="sale-pack-discount">-15%</span>
                </div>
                <div class="sale-pack-body">
                  <div class="sale-pack-pricing">
                    <span class="sale-pack-old-price">S/ 47.40</span>
                    <div class="sale-price-main sale-price-main--pack">S/ 39.90</div>
                    <div class="sale-volume-sub">6 latas de 355 ml</div>
                  </div>
                  <div class="sale-pack-cans-visual" aria-hidden="true">
                    <img src="{{ 'kalpa-can-original.png' | asset_url }}" alt="" class="pack-mini-can pack-mini-can--b1" draggable="false" width="50" height="90">
                    <img src="{{ 'kalpa-can-original.png' | asset_url }}" alt="" class="pack-mini-can pack-mini-can--b2" draggable="false" width="50" height="90">
                    <img src="{{ 'kalpa-can-original.png' | asset_url }}" alt="" class="pack-mini-can pack-mini-can--b3" draggable="false" width="50" height="90">
                    <img src="{{ 'kalpa-can-original.png' | asset_url }}" alt="" class="pack-mini-can pack-mini-can--f1" draggable="false" width="50" height="90">
                    <img src="{{ 'kalpa-can-original.png' | asset_url }}" alt="" class="pack-mini-can pack-mini-can--f2" draggable="false" width="50" height="90">
                    <img src="{{ 'kalpa-can-original.png' | asset_url }}" alt="" class="pack-mini-can pack-mini-can--f3" draggable="false" width="50" height="90">
                  </div>
                </div>
                <button type="button" class="btn-sale-add" onclick="addPackToKallpaCart('pack-6-original', 'Pack x 6 KALPA Original (6x355ml)', 39.90)">
                  <span>AGREGAR</span>
                </button>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- ================= SLIDE 2: KALPA CAFÉ MOLIDO ================= -->
      <div class="kalpa-product-slide kalpa-product-slide--molido" id="product-slide-1" data-slide-index="1">
        <div class="page-width kalpa-sale-container">
          <div class="kalpa-sale-grid">
            
            <!-- Columna 1: Información Editorial de Especialidad -->
            <div class="kalpa-sale__info">
              <span class="sale-top-line"></span>
              <span class="sale-eyebrow">{{ section.settings.slide2_eyebrow | default: 'NUESTRO PRODUCTO' }}</span>
              <h2 class="sale-giant-title">
                <span class="sale-title-main">{{ section.settings.slide2_title_main | default: 'KALPA' }}</span>
                <span class="sale-title-sub">{{ section.settings.slide2_title_sub | default: 'CAFÉ MOLIDO' }}</span>
              </h2>
              <p class="sale-description">
                {{ section.settings.slide2_desc | default: 'Café tostado de origen peruano, 100% Arábica · Variedad Obata. Molienda media fina para métodos de filtrado.' }}
              </p>
              <div style="margin: 0.4rem 0 1rem;">
                <a href="{{ section.settings.slide2_link | default: '/products/kalpa-cafe-molido-250g' }}" style="display: inline-flex; align-items: center; gap: 0.45rem; color: #f5ba2c; font-family: var(--font-brand); font-size: 0.78rem; font-weight: 900; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; transition: opacity 0.2s;">
                  <span>Ver ficha completa</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </a>
              </div>

              <!-- 4 Sellos Circulares Idénticos al Mockup -->
              <div class="sale-features-row">
                <div class="sale-feature-badge">
                  <div class="sale-feature-circle">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
                    </svg>
                  </div>
                  <span class="sale-feature-label">100%<br>ARÁBICA</span>
                </div>

                <div class="sale-feature-badge">
                  <div class="sale-feature-circle">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m8 3 4 8 5-5 5 11H2L8 3z"></path>
                    </svg>
                  </div>
                  <span class="sale-feature-label">ORIGEN<br>VRAEM</span>
                </div>

                <div class="sale-feature-badge">
                  <div class="sale-feature-circle">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M5 22h14"></path>
                      <path d="M5 2h14"></path>
                      <path d="M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22"></path>
                      <path d="M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2"></path>
                    </svg>
                  </div>
                  <span class="sale-feature-label">MOLIENDA<br>MEDIA FINA</span>
                </div>

                <div class="sale-feature-badge">
                  <div class="sale-feature-circle">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"></path>
                      <circle cx="9" cy="14" r="3"></circle>
                      <circle cx="15" cy="14" r="3"></circle>
                    </svg>
                  </div>
                  <span class="sale-feature-label">NOTAS:<br>CEREZA · CHOCOLATE<br>MANZANA</span>
                </div>
              </div>
            </div>

            <!-- Columna 2: Centro (Visual de Lata 250g) -->
            <div class="kalpa-sale__centerpiece">
              <div class="sale-can-stage sale-can-stage--molido">
                <img src="{{ 'kalpa-molido-product.png' | asset_url }}" alt="KALPA Café Molido 250g" class="sale-stage__can sale-stage__can--molido" draggable="false" width="400" height="700">
              </div>
            </div>

            <!-- Columna 3: Tarjeta Dual de Compra (Idéntica a Slide 1) -->
            <div class="kalpa-sale__buy-box">
              <!-- Opción A: Compra por Unidad -->
              <div class="sale-buy-col sale-buy-col--unit">
                <div class="sale-unit-header">Unidad</div>
                <div class="sale-price-block">
                  <div class="sale-price-main">S/ 34.90</div>
                  <div class="sale-volume-sub">250 g</div>
                </div>
                <div class="sale-qty-stepper" aria-label="Cantidad de unidades">
                  <button type="button" class="qty-btn" onclick="updateMolidoUnitQty(-1)" aria-label="Disminuir cantidad">&minus;</button>
                  <span id="molido-unit-qty" class="qty-val">1</span>
                  <button type="button" class="qty-btn" onclick="updateMolidoUnitQty(1)" aria-label="Aumentar cantidad">+</button>
                </div>
                <button type="button" class="btn-sale-add" onclick="addMolidoUnitToCart()">
                  <span>AGREGAR</span>
                  <svg class="sale-add-arrow-mobile" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </button>
              </div>

              <!-- Opción B: Compra Pack x 6 (-15%) -->
              <div class="sale-buy-col sale-buy-col--pack">
                <div class="sale-pack-header">
                  <span class="sale-pack-title">Pack x 6</span>
                  <span class="sale-pack-discount">-15%</span>
                </div>
                <div class="sale-pack-body">
                  <div class="sale-pack-pricing">
                    <span class="sale-pack-old-price">S/ 209.40</span>
                    <div class="sale-price-main sale-price-main--pack">S/ 177.90</div>
                    <div class="sale-volume-sub">6 latas de 250 g</div>
                  </div>
                  <div class="sale-pack-cans-visual" aria-hidden="true">
                    <img src="{{ 'kalpa-molido-can-solo.png' | asset_url }}" alt="" class="pack-mini-can pack-mini-can--b1" draggable="false" width="50" height="90">
                    <img src="{{ 'kalpa-molido-can-solo.png' | asset_url }}" alt="" class="pack-mini-can pack-mini-can--b2" draggable="false" width="50" height="90">
                    <img src="{{ 'kalpa-molido-can-solo.png' | asset_url }}" alt="" class="pack-mini-can pack-mini-can--b3" draggable="false" width="50" height="90">
                    <img src="{{ 'kalpa-molido-can-solo.png' | asset_url }}" alt="" class="pack-mini-can pack-mini-can--f1" draggable="false" width="50" height="90">
                    <img src="{{ 'kalpa-molido-can-solo.png' | asset_url }}" alt="" class="pack-mini-can pack-mini-can--f2" draggable="false" width="50" height="90">
                    <img src="{{ 'kalpa-molido-can-solo.png' | asset_url }}" alt="" class="pack-mini-can pack-mini-can--f3" draggable="false" width="50" height="90">
                  </div>
                </div>
                <button type="button" class="btn-sale-add" onclick="addPackToKallpaCart('pack-6-molido', 'Pack x 6 KALPA Café Molido 250g', 177.90)">
                  <span>AGREGAR</span>
                </button>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Productos en Venta",
  "settings": [
    {
      "type": "text",
      "id": "slide1_eyebrow",
      "label": "Slide 1 - Eyebrow",
      "default": "NUESTRO PRODUCTO"
    },
    {
      "type": "text",
      "id": "slide1_title_main",
      "label": "Slide 1 - Título Principal",
      "default": "KALPA"
    },
    {
      "type": "text",
      "id": "slide1_title_sub",
      "label": "Slide 1 - Subtítulo",
      "default": "ORIGINAL"
    },
    {
      "type": "textarea",
      "id": "slide1_desc",
      "label": "Slide 1 - Descripción",
      "default": "Café cold brew de origen peruano, hecho con granos del VRAEM. 280 mg de cafeína natural. Listo para tomar, en cualquier momento y lugar."
    },
    {
      "type": "url",
      "id": "slide1_link",
      "label": "Slide 1 - Enlace Ficha"
    },
    {
      "type": "text",
      "id": "slide2_eyebrow",
      "label": "Slide 2 - Eyebrow",
      "default": "NUESTRO PRODUCTO"
    },
    {
      "type": "text",
      "id": "slide2_title_main",
      "label": "Slide 2 - Título Principal",
      "default": "KALPA"
    },
    {
      "type": "text",
      "id": "slide2_title_sub",
      "label": "Slide 2 - Subtítulo",
      "default": "CAFÉ MOLIDO"
    },
    {
      "type": "textarea",
      "id": "slide2_desc",
      "label": "Slide 2 - Descripción",
      "default": "Café tostado de origen peruano, 100% Arábica · Variedad Obata. Molienda media fina para métodos de filtrado."
    },
    {
      "type": "url",
      "id": "slide2_link",
      "label": "Slide 2 - Enlace Ficha"
    }
  ],
  "presets": [
    {
      "name": "Productos en Venta"
    }
  ]
}
{% endschema %}
