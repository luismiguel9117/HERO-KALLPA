{%- comment -%}
  SECCIÓN: footer.liquid
  Pie de Página Oficial KALPA: Banner Newsletter Superior + Layout Editorial Multi-Columna
  + Modal Legal Interactivo (Términos, Privacidad, Devoluciones, Libro de Reclamaciones)
{%- endcomment -%}

<footer class="kallpa-footer-wrapper" id="footer-section">
  
  <!-- BANNER NEWSLETTER SUPERIOR: SÉ PARTE DE KALPA -->
  <div class="kallpa-newsletter-banner">
    <!-- Marca de agua con patrón textil andino del hero -->
    <div class="kallpa-newsletter-banner__pattern" aria-hidden="true"></div>
    <div class="kallpa-newsletter-banner__vignette" aria-hidden="true"></div>

    <div class="kallpa-newsletter-container">
      
      <!-- Lata con Hielos y Salpicadura en Primer Plano Izquierdo -->
      <div class="newsletter-banner__can-box">
        <img src="{{ 'footer-banner-can.png' | asset_url }}" alt="Lata KALPA Cold Brew" class="newsletter-banner__can" draggable="false" loading="lazy" width="450" height="450">
      </div>

      <!-- Bloque de Contenido y Formulario -->
      <div class="newsletter-banner__content-box">
        <div class="newsletter-banner__header">
          <h3 class="newsletter-banner__title">{{ section.settings.newsletter_title | default: 'SÉ PARTE DE KALPA' }}</h3>
          <p class="newsletter-banner__desc">{{ section.settings.newsletter_desc | default: 'Recibe promociones exclusivas, lanzamientos y más historias del VRAEM.' }}</p>
        </div>
        <form class="newsletter-banner__form" onsubmit="handleKallpaNewsletter(event, this);">
          <input type="email" placeholder="Tu correo electrónico" class="newsletter-banner__input" required aria-label="Tu correo electrónico">
          <button type="submit" class="newsletter-banner__btn">
            <span>SUSCRIBIRME</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </form>
      </div>

      <!-- Grano de Café en la Esquina Superior Derecha -->
      <div class="newsletter-banner__bean-box" aria-hidden="true">
        <img src="{{ 'hero-bean-single.png' | asset_url }}" alt="" class="newsletter-banner__bean" draggable="false" width="70" height="70">
      </div>

    </div>
  </div>

  <!-- CUERPO PRINCIPAL DEL FOOTER: CUADRÍCULA EDITORIAL MULTI-COLUMNA -->
  <div class="kallpa-footer-bottom">
    <div class="kallpa-footer-bottom__container">
      
      <div class="kallpa-footer__main-grid">
        
        <!-- Columna 1: Marca KALPA -->
        <div class="footer-col footer-col--brand">
          <a href="{{ routes.root_url }}" class="footer-brand-logo" aria-label="KALPA - Inicio">
            <img src="{{ 'logo-kalpa-white.png' | asset_url }}" alt="KALPA" class="footer-logo-img" width="140" height="32">
          </a>
          <p class="footer-brand-tagline">Energía de los Andes</p>
          <p class="footer-brand-desc">
            Café Cold Brew 100% orgánico elaborado con granos arábica del VRAEM a 1,800 msnm. Macerado en frío durante 24 horas para una energía limpia y sostenida.
          </p>
          <div class="footer-brand-badges">
            <span class="footer-badge">🇵🇪 Cosecha VRAEM</span>
            <span class="footer-badge">⚡ 280mg Cafeína</span>
            <span class="footer-badge">🌱 Sin Azúcar Añadida</span>
          </div>
        </div>

        <!-- Columna 2: Tienda -->
        <div class="footer-col footer-col--nav">
          <h4 class="footer-col-title">Tienda</h4>
          <ul class="footer-nav-list">
            <li><a href="/products/kalpa-cold-brew">Cold Brew Original (355 ml)</a></li>
            <li><a href="/products/kalpa-cafe-molido-250g">Café Molido Obata (250 g)</a></li>
            <li><a href="{{ routes.all_products_collection_url }}">Packs & Promociones</a></li>
            <li><a href="{{ routes.root_url }}#origin-section">Envíos a todo el Perú</a></li>
          </ul>
        </div>

        <!-- Columna 3: Nosotros -->
        <div class="footer-col footer-col--nav">
          <h4 class="footer-col-title">Nosotros</h4>
          <ul class="footer-nav-list">
            <li><a href="/pages/contact">Nuestra Historia</a></li>
            <li><a href="{{ routes.root_url }}#origin-section">Origen VRAEM</a></li>
            <li><a href="{{ routes.root_url }}#energy-natural-section">Energía Natural</a></li>
            <li><a href="{{ routes.root_url }}#reels-section">Comunidad & Reseñas</a></li>
          </ul>
        </div>

        <!-- Columna 4: Legal & Soporte -->
        <div class="footer-col footer-col--nav">
          <h4 class="footer-col-title">Legal & Soporte</h4>
          <ul class="footer-nav-list">
            <li><a href="javascript:void(0)" onclick="openLegalModal('terminos')">Términos y Condiciones</a></li>
            <li><a href="javascript:void(0)" onclick="openLegalModal('privacidad')">Políticas de Privacidad</a></li>
            <li><a href="javascript:void(0)" onclick="openLegalModal('devoluciones')">Cambios y Devoluciones</a></li>
            <li><a href="javascript:void(0)" onclick="openLegalModal('reclamaciones')">Libro de Reclamaciones</a></li>
          </ul>
        </div>

        <!-- Columna 5: Conexión & Envíos -->
        <div class="footer-col footer-col--connect">
          <h4 class="footer-col-title">Conecta</h4>
          <p class="footer-connect-desc">Síguenos y sé parte del movimiento de energía limpia de los Andes:</p>
          <div class="footer-social-icons">
            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="footer-social-btn" aria-label="Instagram">
              <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </a>
            <a href="https://tiktok.com" target="_blank" rel="noopener noreferrer" class="footer-social-btn" aria-label="TikTok">
              <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 3 15.68 6.34 6.34 0 0 0 9.33 22a6.33 6.33 0 0 0 6.34-6.32V8.92a8.28 8.28 0 0 0 3.92 1V6.69z"></path>
              </svg>
            </a>
            <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="footer-social-btn" aria-label="YouTube">
              <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"></path>
              </svg>
            </a>
          </div>

          <!-- Envíos a todo el Perú badge -->
          <div class="footer-shipping-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="footer-shipping-icon">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
            <span>Envíos a todo el Perú</span>
          </div>

          <!-- Botón Libro de Reclamaciones -->
          <button type="button" class="footer-reclamaciones-link" onclick="openLegalModal('reclamaciones')">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
            <span>Libro de Reclamaciones</span>
          </button>
        </div>

      </div>

      <!-- Fila Inferior: Copyright, Certificaciones y Métodos de Pago -->
      <div class="footer-bottom__legal-row">
        <p class="footer-copyright">
          © {{ 'now' | date: '%Y' }} {{ shop.name | default: 'KALPA' }}®. Todos los derechos reservados. Café Cold Brew 100% Orgánico del VRAEM.
        </p>
        <div class="footer-payment-assurances">
          <span>🔒 Pago 100% Seguro SSL</span>
          <span class="legal-sep">•</span>
          <span>Aceptamos Tarjetas, Yape y Plin</span>
        </div>
      </div>

    </div>
  </div>

  <!-- MODAL LEGAL INTERACTIVO (Términos, Privacidad, Devoluciones, Reclamaciones) -->
  <div class="kallpa-modal-overlay" id="kallpaLegalModal" onclick="handleLegalModalBackdrop(event)" aria-hidden="true">
    <div class="kallpa-modal-card" role="dialog" aria-modal="true" aria-labelledby="legalModalTitle">
      
      <div class="kallpa-modal-header">
        <div class="kallpa-modal-tabs" role="tablist">
          <button type="button" class="kallpa-modal-tab is-active" data-tab="terminos" onclick="switchLegalTab('terminos')">Términos</button>
          <button type="button" class="kallpa-modal-tab" data-tab="privacidad" onclick="switchLegalTab('privacidad')">Privacidad</button>
          <button type="button" class="kallpa-modal-tab" data-tab="devoluciones" onclick="switchLegalTab('devoluciones')">Devoluciones</button>
          <button type="button" class="kallpa-modal-tab" data-tab="reclamaciones" onclick="switchLegalTab('reclamaciones')">Libro de Reclamaciones</button>
        </div>
        <button type="button" class="kallpa-modal-close" onclick="closeLegalModal()" aria-label="Cerrar modal">&times;</button>
      </div>

      <div class="kallpa-modal-body" id="legalModalContent">
        <!-- Renderizado dinámico vía script -->
      </div>

    </div>
  </div>

</footer>

<script>
  // Manejo elegante del formulario Newsletter
  function handleKallpaNewsletter(e, form) {
    e.preventDefault();
    const input = form.querySelector('input[type="email"]');
    if (!input || !input.value.trim()) return;

    const email = input.value.trim();
    if (typeof window.showKallpaToast === 'function') {
      window.showKallpaToast('¡Gracias por unirte a KALPA! Te enviaremos promociones exclusivas a ' + email);
    } else {
      alert('¡Gracias por unirte a la comunidad KALPA!');
    }
    input.value = '';
  }

  // Textos y contenido de soporte legal
  const KALLPA_LEGAL_DOCS = {
    terminos: {
      title: 'Términos y Condiciones de Uso',
      body: `
        <h4>1. Aceptación de los Términos</h4>
        <p>Al acceder y utilizar el sitio web oficial de KALPA (kallpa-fuyxyult.myshopify.com), usted acepta quedar vinculado por estos Términos y Condiciones, así como por todas las leyes aplicables en la República del Perú.</p>
        <h4>2. Productos y Disponibilidad</h4>
        <p>KALPA comercializa café cold brew listo para tomar y café tostado y molido en empaques de origen. Todos los pedidos están sujetos a disponibilidad de inventario y confirmación de pago.</p>
        <h4>3. Precios y Facturación</h4>
        <p>Todos los precios se encuentran expresados en Soles Peruanos (S/) e incluyen los impuestos de ley (IGV). Las órdenes se procesan de forma segura a través de nuestra pasarela de pagos integrada de Shopify.</p>
        <h4>4. Propiedad Intelectual</h4>
        <p>Las marcas registradas KALPA®, logotipos, recetas de formulación y material visual son propiedad exclusiva de HERO-KALLPA LABS S.A.C.</p>
      `
    },
    privacidad: {
      title: 'Política de Privacidad y Tratamiento de Datos',
      body: `
        <h4>1. Responsable del Tratamiento</h4>
        <p>HERO-KALLPA LABS S.A.C. cumple con la Ley N° 29733 (Ley de Protección de Datos Personales del Perú) y su Reglamento.</p>
        <h4>2. Información Recopilada</h4>
        <p>Recopilamos únicamente datos necesarios para el procesamiento, despacho y entrega de sus pedidos (nombre, documento de identidad, dirección, teléfono y correo electrónico).</p>
        <h4>3. Seguridad de Pagos</h4>
        <p>KALPA nunca almacena números completos de tarjetas de crédito o débito. Las transacciones son procesadas mediante conexiones cifradas SSL de 256 bits certificadas por Shopify Payments.</p>
        <h4>4. Derechos ARCO</h4>
        <p>Usted puede ejercer sus derechos de acceso, rectificación, cancelación u oposición enviando una solicitud a contacto@kalpaenergy.pe.</p>
      `
    },
    devoluciones: {
      title: 'Políticas de Envíos, Cambios y Devoluciones',
      body: `
        <h4>1. Cobertura y Tiempos de Entrega</h4>
        <p>Realizamos despachos a todo el Perú. En Lima Metropolitana la entrega toma de 24 a 48 horas hábiles. En provincias, el envío toma de 3 a 5 días hábiles vía courier certificado.</p>
        <h4>2. Garantía de Calidad</h4>
        <p>Si algún producto llega con sellos vulnerados, abolladuras severas o problemas de hermeticidad, gestionamos el reemplazo inmediato sin costo alguno para el cliente.</p>
        <h4>3. Solicitud de Cambio</h4>
        <p>Para solicitar un cambio o reporte de lote, contáctenos dentro de las primeras 48 horas posteriores a la recepción con foto del producto a contacto@kalpaenergy.pe o vía WhatsApp.</p>
      `
    },
    reclamaciones: {
      title: 'Libro de Reclamaciones Virtual',
      body: `
        <p class="legal-lead">Conforme a lo dispuesto por el Código de Protección y Defensa del Consumidor (Ley N° 29571), ponemos a su disposición nuestro Libro de Reclamaciones Virtual.</p>
        <form class="kallpa-reclamacion-form" onsubmit="event.preventDefault(); window.showKallpaToast ? window.showKallpaToast('Hoja de reclamación registrada. Nos comunicaremos en menos de 48 horas.') : alert('Reclamo registrado con éxito'); closeLegalModal();">
          <div class="rec-field-row">
            <div class="rec-field">
              <label>Nombre y Apellidos *</label>
              <input type="text" required placeholder="Tu nombre completo">
            </div>
            <div class="rec-field">
              <label>DNI / CE *</label>
              <input type="text" required placeholder="N° de Documento">
            </div>
          </div>
          <div class="rec-field-row">
            <div class="rec-field">
              <label>Correo Electrónico *</label>
              <input type="email" required placeholder="correo@ejemplo.com">
            </div>
            <div class="rec-field">
              <label>Teléfono / Celular *</label>
              <input type="tel" required placeholder="999 999 999">
            </div>
          </div>
          <div class="rec-field">
            <label>Tipo de Registro *</label>
            <select required style="width: 100%; padding: 0.75rem; border-radius: 8px; background: #12151b; color: #fff; border: 1px solid rgba(255,255,255,0.15);">
              <option value="queja">Queja (Malestar respecto a la atención)</option>
              <option value="reclamo">Reclamo (Disconformidad con el producto o servicio)</option>
            </select>
          </div>
          <div class="rec-field">
            <label>Detalle del Reclamo o Queja *</label>
            <textarea rows="4" required placeholder="Describa los hechos ocurridos..." style="width: 100%; padding: 0.75rem; border-radius: 8px; background: #12151b; color: #fff; border: 1px solid rgba(255,255,255,0.15); font-family: inherit;"></textarea>
          </div>
          <button type="submit" class="rec-submit-btn">
            REGISTRAR HOJA DE RECLAMACIÓN
          </button>
        </form>
      `
    }
  };

  function switchLegalTab(tabId) {
    const tabs = document.querySelectorAll('.kallpa-modal-tab');
    tabs.forEach(t => {
      t.classList.toggle('is-active', t.getAttribute('data-tab') === tabId);
    });

    const contentBox = document.getElementById('legalModalContent');
    if (!contentBox) return;

    const data = KALLPA_LEGAL_DOCS[tabId] || KALLPA_LEGAL_DOCS.terminos;
    contentBox.innerHTML = `
      <h3 id="legalModalTitle" class="legal-doc-title">${data.title}</h3>
      <div class="legal-doc-body">${data.body}</div>
    `;
  }

  function openLegalModal(tabId = 'terminos') {
    const modal = document.getElementById('kallpaLegalModal');
    if (!modal) return;
    switchLegalTab(tabId);
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeLegalModal() {
    const modal = document.getElementById('kallpaLegalModal');
    if (!modal) return;
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  function handleLegalModalBackdrop(e) {
    if (e.target.id === 'kallpaLegalModal') {
      closeLegalModal();
    }
  }

  // Exponer a nivel global
  window.openLegalModal = openLegalModal;
  window.closeLegalModal = closeLegalModal;
  window.switchLegalTab = switchLegalTab;
  window.handleLegalModalBackdrop = handleLegalModalBackdrop;
</script>

{% schema %}
{
  "name": "Footer KALPA",
  "settings": [
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Título del Newsletter",
      "default": "SÉ PARTE DE KALPA"
    },
    {
      "type": "text",
      "id": "newsletter_desc",
      "label": "Descripción del Newsletter",
      "default": "Recibe promociones exclusivas, lanzamientos y más historias del VRAEM."
    }
  ]
}
{% endschema %}