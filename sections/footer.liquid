{%- comment -%}
  SECCIÓN: footer.liquid
  Pie de Página Oficial KALPA: Banner Newsletter Superior + Layout Editorial Multi-Columna
  Enlaces directos a Páginas Legales Standalone Oficiales (Términos, Privacidad, Devoluciones, Libro de Reclamaciones)
{%- endcomment -%}

<footer class="kallpa-footer-wrapper" id="footer-section">
  
  <!-- BANNER NEWSLETTER SUPERIOR: SÉ PARTE DE KALPA -->
  <div class="kallpa-newsletter-banner">
    <!-- Marca de agua con patrón textil andino del hero -->
    <div class="kallpa-newsletter-banner__pattern" aria-hidden="true"></div>
    <div class="kallpa-newsletter-banner__vignette" aria-hidden="true"></div>

    <div class="kallpa-newsletter-container">
      
      <!-- Lata con Hielos y Salpicadura en Primer Plano Izquierdo -->
      <div class="newsletter-banner__can-box">
        <img src="{{ 'footer-banner-can.webp' | asset_url }}" alt="Lata KALPA Cold Brew" class="newsletter-banner__can" draggable="false" loading="lazy" width="450" height="450">
      </div>

      <!-- Bloque de Contenido y Formulario -->
      <div class="newsletter-banner__content-box">
        <div class="newsletter-banner__header">
          <h3 class="newsletter-banner__title">{{ section.settings.newsletter_title | default: 'SÉ PARTE DE KALPA' }}</h3>
          <p class="newsletter-banner__desc">{{ section.settings.newsletter_desc | default: 'Recibe promociones exclusivas, lanzamientos y más historias del VRAEM.' }}</p>
        </div>
        <form class="newsletter-banner__form" onsubmit="handleKallpaNewsletter(event, this);">
          <input type="email" placeholder="Tu correo electrónico" class="newsletter-banner__input" required aria-label="Tu correo electrónico">
          <button type="submit" class="newsletter-banner__btn">
            <span>SUSCRIBIRME</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </form>
      </div>

      <!-- Grano de Café en la Esquina Superior Derecha -->
      <div class="newsletter-banner__bean-box" aria-hidden="true">
        <img loading="lazy" decoding="async" src="{{ 'hero-bean-single.png' | asset_url }}" alt="" class="newsletter-banner__bean" draggable="false" width="70" height="70">
      </div>

    </div>
  </div>

  <!-- CUERPO PRINCIPAL DEL FOOTER: CUADRÍCULA EDITORIAL MULTI-COLUMNA -->
  <div class="kallpa-footer-bottom">
    <div class="kallpa-footer-bottom__container">
      
      <div class="kallpa-footer__main-grid">
        
        <!-- Columna 1: Marca KALPA -->
        <div class="footer-col footer-col--brand">
          <a href="{{ routes.root_url }}" class="footer-brand-logo" aria-label="KALPA - Inicio">
            <img loading="lazy" decoding="async" src="{{ 'logo-kalpa-white.png' | asset_url }}" alt="KALPA" class="footer-logo-img" width="140" height="32">
          </a>
          <p class="footer-brand-tagline">Energía de los Andes</p>
          <p class="footer-brand-desc">
            Café Cold Brew 100% orgánico elaborado con granos arábica del VRAEM a 1,800 msnm. Macerado en frío durante 24 horas para una energía limpia y sostenida.
          </p>
          <div class="footer-brand-badges">
            <span class="footer-badge">🇵🇪 Cosecha VRAEM</span>
            <span class="footer-badge">⚡ 280mg Cafeína</span>
            <span class="footer-badge">🌱 Sin Azúcar Añadida</span>
          </div>
        </div>

        <!-- Columna 2: Tienda -->
        <div class="footer-col footer-col--nav">
          <h4 class="footer-col-title">Tienda</h4>
          <ul class="footer-nav-list">
            {%- assign cold_brew = all_products['kallpa-cold-brew-original'] -%}
            {%- assign cafe_molido = all_products['cafe-molido-250-g'] -%}
            <li><a href="{{ cold_brew.url | default: routes.all_products_collection_url }}">Cold Brew Original (355 ml)</a></li>
            <li><a href="{{ cafe_molido.url | default: routes.all_products_collection_url }}">Café Molido Obata (250 g)</a></li>
            <li><a href="/pages/promociones">Packs & Promociones</a></li>
            <li><a href="{{ routes.root_url }}#origin-section">Envíos a todo el Perú</a></li>
          </ul>
        </div>

        <!-- Columna 3: Nosotros -->
        <div class="footer-col footer-col--nav">
          <h4 class="footer-col-title">Nosotros</h4>
          <ul class="footer-nav-list">
            <li><a href="/pages/contact">Nuestra Historia</a></li>
            <li><a href="{{ routes.root_url }}#origin-section">Origen VRAEM</a></li>
            <li><a href="{{ routes.root_url }}#energy-natural-section">Energía Natural</a></li>
            <li><a href="{{ routes.root_url }}#reels-section">Comunidad & Reseñas</a></li>
          </ul>
        </div>

        <!-- Columna 4: Legal & Soporte (Páginas Standalone Oficiales) -->
        <div class="footer-col footer-col--nav">
          <h4 class="footer-col-title">Legal & Soporte</h4>
          <ul class="footer-nav-list">
            {%- comment -%} Cada enlace usa la página si existe, si no la política de Shopify; si no hay ninguna, se oculta {%- endcomment -%}
            {%- liquid
              assign url_terminos = pages['terminos-y-condiciones'].url | default: shop.terms_of_service.url
              assign url_privacidad = pages['politicas-de-privacidad'].url | default: shop.privacy_policy.url
              assign url_devoluciones = pages['cambios-y-devoluciones'].url | default: shop.refund_policy.url
              assign url_reclamaciones = pages['libro-de-reclamaciones'].url
            -%}
            {%- if url_terminos != blank -%}<li><a href="{{ url_terminos }}">Términos y Condiciones</a></li>{%- endif -%}
            {%- if url_privacidad != blank -%}<li><a href="{{ url_privacidad }}">Políticas de Privacidad</a></li>{%- endif -%}
            {%- if url_devoluciones != blank -%}<li><a href="{{ url_devoluciones }}">Cambios y Devoluciones</a></li>{%- endif -%}
            {%- if url_reclamaciones != blank -%}<li><a href="{{ url_reclamaciones }}">Libro de Reclamaciones</a></li>{%- endif -%}
          </ul>
        </div>

        <!-- Columna 5: Conexión & Envíos -->
        <div class="footer-col footer-col--connect">
          <h4 class="footer-col-title">Conecta</h4>
          <p class="footer-connect-desc">Síguenos y sé parte del movimiento de energía limpia de los Andes:</p>
          <div class="footer-social-icons">
            <a href="https://www.instagram.com/kalpacoldbrew/" target="_blank" rel="noopener noreferrer" class="footer-social-btn" aria-label="Instagram">
              <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </a>
            {%- comment -%} TikTok y YouTube ocultos hasta tener cuentas oficiales {%- endcomment -%}
          </div>

          <!-- Envíos a todo el Perú badge -->
          <div class="footer-shipping-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="footer-shipping-icon">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
            <span>Envíos a todo el Perú</span>
          </div>

          <!-- Enlace Libro de Reclamaciones -->
          {%- if url_reclamaciones != blank -%}
          <a href="{{ url_reclamaciones }}" class="footer-reclamaciones-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
            <span>Libro de Reclamaciones</span>
          </a>
          {%- endif -%}
        </div>

      </div>

      <!-- Fila Inferior: Copyright, Certificaciones y Métodos de Pago -->
      <div class="footer-bottom__legal-row">
        <p class="footer-copyright">
          © {{ 'now' | date: '%Y' }} {{ shop.name | default: 'KALPA' }}®. Todos los derechos reservados. Café Cold Brew 100% Orgánico del VRAEM.
        </p>
        <div class="footer-payment-assurances">
          <span>🔒 Pago 100% Seguro SSL</span>
          <span class="legal-sep">•</span>
          <span>Aceptamos Tarjetas, Yape y Plin</span>
        </div>
      </div>

    </div>
  </div>

</footer>

<script>
  // Manejo elegante del formulario Newsletter
  function handleKallpaNewsletter(e, form) {
    e.preventDefault();
    const input = form.querySelector('input[type="email"]');
    if (!input || !input.value.trim()) return;

    const email = input.value.trim();
    if (typeof window.showKallpaToast === 'function') {
      window.showKallpaToast('¡Gracias por unirte a KALPA! Te enviaremos promociones exclusivas a ' + email);
    } else {
      alert('¡Gracias por unirte a la comunidad KALPA!');
    }
    input.value = '';
  }
</script>

{% schema %}
{
  "name": "Footer KALPA",
  "settings": [
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Título del Newsletter",
      "default": "SÉ PARTE DE KALPA"
    },
    {
      "type": "text",
      "id": "newsletter_desc",
      "label": "Descripción del Newsletter",
      "default": "Recibe promociones exclusivas, lanzamientos y más historias del VRAEM."
    }
  ]
}
{% endschema %}