{%- comment -%}
  SECCIÓN: footer.liquid
  Pie de Página Oficial KALPA con Banner Newsletter Superior (Idéntico a la Referencia)
{%- endcomment -%}

<footer class="kallpa-footer-wrapper" id="footer-section">
  
  <!-- BANNER NEWSLETTER SUPERIOR: SÉ PARTE DE KALPA -->
  <div class="kallpa-newsletter-banner">
    <!-- Marca de agua con patrón textil andino del hero -->
    <div class="kallpa-newsletter-banner__pattern" aria-hidden="true"></div>
    <div class="kallpa-newsletter-banner__vignette" aria-hidden="true"></div>

    <div class="kallpa-newsletter-container">
      
      <!-- Lata con Hielos y Salpicadura en Primer Plano Izquierdo -->
      <div class="newsletter-banner__can-box">
        <img src="{{ 'footer-banner-can.png' | asset_url }}" alt="Lata KALPA Cold Brew" class="newsletter-banner__can" draggable="false" loading="lazy">
      </div>

      <!-- Bloque de Contenido y Formulario -->
      <div class="newsletter-banner__content-box">
        <div class="newsletter-banner__header">
          <h3 class="newsletter-banner__title">{{ section.settings.newsletter_title | default: 'SÉ PARTE DE KALPA' }}</h3>
          <p class="newsletter-banner__desc">{{ section.settings.newsletter_desc | default: 'Recibe promociones exclusivas, lanzamientos y más historias del VRAEM.' }}</p>
        </div>
        <form class="newsletter-banner__form" onsubmit="event.preventDefault(); alert('¡Gracias por unirte a la comunidad KALPA!');">
          <input type="email" placeholder="Tu correo electrónico" class="newsletter-banner__input" required aria-label="Tu correo electrónico">
          <button type="submit" class="newsletter-banner__btn">
            <span>SUSCRIBIRME</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </form>
      </div>

      <!-- Grano de Café en la Esquina Superior Derecha (sobre el botón) -->
      <div class="newsletter-banner__bean-box" aria-hidden="true">
        <img src="{{ 'hero-bean-single.png' | asset_url }}" alt="" class="newsletter-banner__bean" draggable="false">
      </div>

    </div>
  </div>

  <!-- BARRA INFERIOR DEL FOOTER: LOGO, MENÚ, REDES, ENVÍOS Y LEGAL -->
  <div class="kallpa-footer-bottom">
    <div class="kallpa-footer-bottom__container">
      
      <!-- Fila 1: Logo + Navegación + Redes Sociales + Envíos a todo el Perú -->
      <div class="footer-bottom__main-row">
        
        <!-- Logo KALPA -->
        <a href="/" class="footer-logo-link" aria-label="KALPA - Inicio">
          <img src="{{ 'logo-kalpa-white.png' | asset_url }}" alt="KALPA" class="footer-logo-img" width="135" height="32">
        </a>

        <!-- Menú Horizontal de Enlaces -->
        <nav class="footer-horizontal-nav" aria-label="Navegación pie de página">
          <a href="#hero-section">Inicio</a>
          <a href="#products-section">Productos</a>
          <a href="#products-section">Tienda</a>
          <a href="#origin-section">Promociones</a>
          <a href="#clean-energy-section">Nosotros</a>
        </nav>

        <!-- Iconos de Redes Sociales -->
        <div class="footer-social-icons">
          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="footer-social-btn" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <a href="https://tiktok.com" target="_blank" rel="noopener noreferrer" class="footer-social-btn" aria-label="TikTok">
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 3 15.68 6.34 6.34 0 0 0 9.33 22a6.33 6.33 0 0 0 6.34-6.32V8.92a8.28 8.28 0 0 0 3.92 1V6.69z"></path>
            </svg>
          </a>
          <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="footer-social-btn" aria-label="YouTube">
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"></path>
            </svg>
          </a>
        </div>

        <!-- Envíos a todo el Perú -->
        <div class="footer-shipping-badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="footer-shipping-icon">
            <rect x="1" y="3" width="15" height="13"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
          <span>Envíos a todo el Perú.</span>
        </div>

      </div>

      <!-- Fila 2: Copyright y Enlaces Legales -->
      <div class="footer-bottom__legal-row">
        <p class="footer-copyright">&copy; 2024 KALPA. Todos los derechos reservados.</p>
        <div class="footer-legal-links">
          <a href="#footer-section">Términos y condiciones</a>
          <span class="legal-sep">|</span>
          <a href="#footer-section">Política de privacidad</a>
          <span class="legal-sep">|</span>
          <a href="mailto:Ventas@kalpa.pe">Contacto</a>
        </div>
      </div>

    </div>
  </div>

</footer>

{% schema %}
{
  "name": "Footer KALPA",
  "settings": [
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Título Newsletter",
      "default": "SÉ PARTE DE KALPA"
    },
    {
      "type": "text",
      "id": "newsletter_desc",
      "label": "Descripción Newsletter",
      "default": "Recibe promociones exclusivas, lanzamientos y más historias del VRAEM."
    }
  ]
}
{% endschema %}
