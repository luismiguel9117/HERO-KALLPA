{%- comment -%}
  SECCIÓN: footer.liquid
  Pie de Página Oficial KALPA (Idéntico al Mockup de Marca)
{%- endcomment -%}

<footer class="kallpa-footer" id="footer-section">
  <div class="page-width">
    
    <div class="kallpa-footer__main-grid">
      
      <!-- Columna 1: Marca y Copyright -->
      <div class="footer-brand-col">
        <a href="/" class="footer-brand-logo" aria-label="KALPA - Inicio">
          <img src="{{ 'logo-kalpa-white.png' | asset_url }}" alt="KALPA Logo" class="footer-logo__img" width="165" height="38" />
        </a>
        <p class="footer-brand-tagline">Energía de los Andes</p>
        <p class="footer-brand-copy">&copy; 2026 KALPA. Todos los derechos reservados.</p>
      </div>

      <!-- Columna 2: Tienda -->
      <div class="footer-links-col">
        <h4 class="footer-col-title">Tienda</h4>
        <ul class="footer-nav-list">
          <li><a href="#products-section">Productos</a></li>
          <li><a href="#promo-section">Promociones</a></li>
          <li><a href="#origin-section">Envíos</a></li>
          <li><a href="#benefits-section">Preguntas Frecuentes</a></li>
        </ul>
      </div>

      <!-- Columna 3: Nosotros -->
      <div class="footer-links-col">
        <h4 class="footer-col-title">Nosotros</h4>
        <ul class="footer-nav-list">
          <li><a href="#clean-energy-section">Nuestra historia</a></li>
          <li><a href="#origin-section">Origen</a></li>
          <li><a href="#footer-section">Contacto</a></li>
        </ul>
      </div>

      <!-- Columna 4: Legal -->
      <div class="footer-links-col">
        <h4 class="footer-col-title">Legal</h4>
        <ul class="footer-nav-list">
          <li><a href="#footer-section">Términos y condiciones</a></li>
          <li><a href="#footer-section">Política de privacidad</a></li>
          <li><a href="#footer-section">Cambios y devoluciones</a></li>
        </ul>
      </div>

      <!-- Columna 5: Contacto y Redes Sociales -->
