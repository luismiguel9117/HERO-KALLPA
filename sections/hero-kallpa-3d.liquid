{%- comment -%}
  SECCIÓN: hero-kallpa-3d.liquid
  Hero Carousel de Banners con Lata 3D Ultra-HD en posición diagonal (Pixel-Perfect con Mockup)
{%- endcomment -%}

<section class="kalpa-hero-carousel" id="hero-section" style="background-image: url('{{ 'kalpa-hero-bg.png' | asset_url }}');">
  
  <!-- 1. Marca de agua con patrón textil andino -->
  <div class="kalpa-hero__pattern"></div>

  <!-- 2. Resplandor de Luz Dorado posicionado detrás de la lata (Backlight & Rim Flare) -->
  <div class="kalpa-hero__backlight">
    <div class="kalpa-hero__backlight-glow"></div>
    <div class="kalpa-hero__backlight-core"></div>
    <div class="kalpa-hero__backlight-flare"></div>
  </div>

  <!-- 3. Elementos de Cacao con Difuminación jugando con los planos (Foreground, Midground, Background) -->
  <div class="cacao-beans-viewport" id="cacao-beans-viewport">
    <!-- PLANO 1: Primer plano desenfocado (Foreground Bokeh) -->
    <div class="cacao-bean cacao-bean--top-left" data-depth="0.08" data-plane="foreground">
      <img src="{{ 'cacao-1.png' | asset_url }}" alt="" class="cacao-bean__img cacao-anim--float-1" draggable="false">
    </div>
    <div class="cacao-bean cacao-bean--bottom-left" data-depth="0.09" data-plane="foreground">
      <img src="{{ 'cacao-1.png' | asset_url }}" alt="" class="cacao-bean__img cacao-anim--float-2" draggable="false">
    </div>
    <div class="cacao-bean cacao-bean--bottom-right" data-depth="0.08" data-plane="foreground">
      <img src="{{ 'cacao-1.png' | asset_url }}" alt="" class="cacao-bean__img cacao-anim--float-3" draggable="false">
    </div>

    <!-- PLANO 2: Plano medio enfocado / nítido (Midground Focus) -->
    <div class="cacao-bean cacao-bean--mid-floating" data-depth="0.035" data-plane="midground">
      <img src="{{ 'cacao-3.png' | asset_url }}" alt="" class="cacao-bean__img cacao-anim--float-4" draggable="false">
    </div>
    <div class="cacao-bean cacao-bean--bottom-center-1" data-depth="0.04" data-plane="midground">
      <img src="{{ 'cacao-3.png' | asset_url }}" alt="" class="cacao-bean__img cacao-anim--float-5" draggable="false">
    </div>
    <div class="cacao-bean cacao-bean--bottom-center-2" data-depth="0.045" data-plane="midground">
      <img src="{{ 'cacao-2.png' | asset_url }}" alt="" class="cacao-bean__img cacao-anim--float-6" draggable="false">
    </div>

    <!-- PLANO 3: Plano de fondo / profundidad (Background Depth) -->
    <div class="cacao-bean cacao-bean--top-right" data-depth="0.02" data-plane="background">
      <img src="{{ 'cacao-6.png' | asset_url }}" alt="" class="cacao-bean__img cacao-anim--float-7" draggable="false">
    </div>
  </div>

  <!-- 4. Viewport 3D WebGL con la Lata 3D Oficial KALPA (Three.js) -->
  <div id="kallpa-hero-3d" 
       class="hero-3d-viewport"
       data-energy-color="#fdb515"
       data-secondary-color="#ff9100"
       data-fbx-path="{{ 'SM_BeerCan_A.fbx' | asset_url }}"
       data-can-label="{{ 'can-kalpa-label.png' | asset_url }}"
       data-can-base="{{ 'can-base.png' | asset_url }}"
       data-can-normal="{{ 'can-normal.png' | asset_url }}"
       data-can-rmao="{{ 'can-rmao.png' | asset_url }}">
  </div>

  <!-- 5. Viewport 2D con la Lata Estudio KALPA -->
  <div id="kallpa-hero-2d-can" class="hero-2d-can-viewport">
    <div class="hero-2d-can-wrapper">
      <div class="hero-2d-can-card" id="hero-2d-can-card">
        <img src="{{ 'kalpa-can-clean.png' | asset_url }}" class="hero-2d-can__base" alt="Lata KALPA Cold Brew 2D" draggable="false">
        <img src="{{ 'kalpa-can-droplets.png' | asset_url }}" class="hero-2d-can__droplets" alt="Gotas de condensación" draggable="false">
      </div>
    </div>
  </div>

  <!-- 6. Canvas 2D para micro-partículas atmosféricas -->
  <canvas id="kallpa-hero-2d" class="hero-2d-canvas"></canvas>

  <!-- 6. Carrusel de Banners y Contenido Editorial -->
  <div class="page-width" style="position: relative; z-index: 10; width: 100%;">
    <div class="kalpa-carousel-slides" id="kalpa-carousel-slides">
      
      {%- for block in section.blocks -%}
        <div class="kalpa-slide {% if forloop.first %}is-active{% endif %}" 
             data-slide-index="{{ forloop.index0 }}"
             {{ block.shopify_attributes }}>
          <div class="kalpa-hero__left-content">
            <h1 class="kalpa-hero__giant-title">
              <span class="title-white">{{ block.settings.lead_title | default: 'CAFÉ DE' }}</span>
              <span class="title-gold">{{ block.settings.giant_title | default: 'VRAEM' }}</span>
            </h1>
            <p class="kalpa-hero__paragraph">{{ block.settings.description | default: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Quis ipsum suspendisse ultrices gravida. Risus commodo viverra maecenas accumsan lacus vel facilisis.' }}</p>
            
            <div class="kalpa-hero__actions">
              <a href="{{ block.settings.btn_url | default: '#products-section' }}" class="btn-pruebala">
                <span>{{ block.settings.btn_text | default: 'PRUEBALA AHORA' }}</span>
              </a>
            </div>
          </div>
        </div>
      {%- endfor -%}

    </div>
  </div>

  <!-- 7. Controles de Navegación del Carrusel (Flechas, Bullets y Switch 2D/3D) -->
  <div class="kalpa-carousel-nav">
    <button type="button" class="carousel-btn-arrow" id="carousel-prev" aria-label="Banner Anterior">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <div class="carousel-dots" id="carousel-dots">
      {%- for block in section.blocks -%}
        <button type="button" 
                class="carousel-dot {% if forloop.first %}is-active{% endif %}" 
                data-dot-index="{{ forloop.index0 }}" 
                aria-label="Ir a diapositiva {{ forloop.index }}">
        </button>
      {%- endfor -%}
    </div>

    <button type="button" class="carousel-btn-arrow" id="carousel-next" aria-label="Siguiente Banner">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>

    <!-- Separador Sutil en Barra de Controles -->
    <span class="nav-control-separator"></span>

    <!-- Switch de Alternancia 2D / 3D -->
    <div class="kalpa-dimension-switch" id="kalpa-dimension-switch" data-active="3d" role="radiogroup" aria-label="Alternar modo 2D y 3D">
      <button type="button" class="dim-switch-btn" data-mode="2d" id="btn-dim-2d" role="radio" aria-checked="false" aria-label="Modo 2D Foto Estudio">
        <span class="dim-badge">2D</span>
        <span class="dim-text">FOTO</span>
      </button>
      <button type="button" class="dim-switch-btn is-active" data-mode="3d" id="btn-dim-3d" role="radio" aria-checked="true" aria-label="Modo 3D Interactivo">
        <span class="dim-badge">3D</span>
        <span class="dim-text">INTERACTIVO</span>
      </button>
      <span class="dim-switch-glider"></span>
    </div>
  </div>

</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const slides = document.querySelectorAll('.kalpa-slide');
    const dots = document.querySelectorAll('.carousel-dot');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');
    
    if (!slides.length) return;

    let currentIndex = 0;
    let autoPlayTimer = null;

    function goToSlide(index) {
      if (index < 0) index = slides.length - 1;
      if (index >= slides.length) index = 0;

      slides.forEach((s, idx) => {
        s.classList.toggle('is-active', idx === index);
      });

      dots.forEach((d, idx) => {
        d.classList.toggle('is-active', idx === index);
      });

      currentIndex = index;

      // Animar y reaccionar la lata 3D al cambio de diapositiva
      document.dispatchEvent(new CustomEvent('kallpa:slidechange', { detail: { index: currentIndex } }));
      if (window.kallpa3D && typeof window.kallpa3D.transitionSlide === 'function') {
        window.kallpa3D.transitionSlide(currentIndex);
      }
    }

    if (prevBtn) prevBtn.addEventListener('click', () => {
      goToSlide(currentIndex - 1);
      resetAutoPlay();
    });

    if (nextBtn) nextBtn.addEventListener('click', () => {
      goToSlide(currentIndex + 1);
      resetAutoPlay();
    });

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => {
        goToSlide(idx);
        resetAutoPlay();
      });
    });

    function startAutoPlay() {
      autoPlayTimer = setInterval(() => {
        goToSlide(currentIndex + 1);
      }, 6500);
    }

    function resetAutoPlay() {
      clearInterval(autoPlayTimer);
      startAutoPlay();
    }

    startAutoPlay();
  });
</script>

