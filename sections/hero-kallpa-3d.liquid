{%- comment -%}
  SECCIÓN: hero-kallpa-3d.liquid
  Hero Carousel de Banners con Lata 3D Ultra-HD en posición diagonal (Pixel-Perfect con Mockup)
{%- endcomment -%}

<section class="kalpa-hero-carousel" id="hero-section" style="background-image: url('{{ 'kalpa-hero-bg.png' | asset_url }}');">
  
  <!-- 1. Marca de agua con patrón textil andino -->
  <div class="kalpa-hero__pattern"></div>

  <!-- 2. Resplandor solar dorado detrás de la lata (Lens Flare) -->
  <div class="kalpa-hero__glow"></div>

  <!-- 3. Granos de café tostado flotantes con profundidad de campo (Bokeh) -->
  <div class="floating-beans-container">
    <div class="coffee-bean-floating bean--1"></div>
    <div class="coffee-bean-floating bean--2"></div>
    <div class="coffee-bean-floating bean--3"></div>
    <div class="coffee-bean-floating bean--4"></div>
    <div class="coffee-bean-floating bean--5"></div>
  </div>

  <!-- 4. Viewport 3D con la Lata Oficial KALPA (Motor Híbrido 2D/3D) -->
  <div id="kallpa-hero-3d" 
       class="hero-3d-viewport"
       data-energy-color="#fdb515"
       data-secondary-color="#ff9100"
       data-base-can="{{ 'kalpa-can-clean.png' | asset_url }}"
       data-droplets="{{ 'kalpa-can-droplets.png' | asset_url }}"
       data-label-original="{{ 'kalpa-label.png' | asset_url }}"
       data-label-gold="{{ 'kalpa-label-gold.png' | asset_url }}"
       data-label-citrus="{{ 'kalpa-label-citrus.png' | asset_url }}">
  </div>

  <!-- 5. Canvas 2D para micro-partículas atmosféricas -->
  <canvas id="kallpa-hero-2d" class="hero-2d-canvas"></canvas>

  <!-- 6. Carrusel de Banners y Contenido Editorial -->
  <div class="page-width" style="position: relative; z-index: 10; width: 100%;">
    <div class="kalpa-carousel-slides" id="kalpa-carousel-slides">
      
      {%- for block in section.blocks -%}
        <div class="kalpa-slide {% if forloop.first %}is-active{% endif %}" 
             data-slide-index="{{ forloop.index0 }}"
             {{ block.shopify_attributes }}>
          <div class="kalpa-hero__left-content">
            <span class="kalpa-hero__eyebrow">{{ block.settings.eyebrow | default: 'ENERGÍA NATURAL DE LOS ANDES' }}</span>
            <span class="kalpa-hero__giant-title">
              <span class="title-white">{{ block.settings.lead_title | default: 'CAFÉ DE' }}</span>
              <span class="title-gold">{{ block.settings.giant_title | default: 'VRAEM' }}</span>
            </span>
            <p class="kalpa-hero__paragraph">{{ block.settings.description | default: 'Energía natural para tu día. Café cold brew listo para tomar, hecho con granos del VRAEM y con todo el sabor de los Andes.' }}</p>
            
            <div class="kalpa-hero__actions">
              <a href="{{ block.settings.btn_url | default: '#products-section' }}" class="btn-pruebala">
                <span>{{ block.settings.btn_text | default: 'COMPRAR AHORA' }}</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>

            <!-- 3 Badges de Rendimiento Andino -->
            <div class="kalpa-hero__badges">
              <div class="hero-badge"><span class="badge-icon">🍃</span> Sin azúcar</div>
              <div class="hero-badge"><span class="badge-icon">⚡</span> 280 mg de cafeína</div>
              <div class="hero-badge"><span class="badge-icon">🏔️</span> De los Andes</div>
            </div>
          </div>
        </div>
      {%- endfor -%}

    </div>
  </div>

  <!-- 7. Controles de Navegación del Carrusel (Flechas y Bullets) -->
  <div class="kalpa-carousel-nav">
    <button type="button" class="carousel-btn-arrow" id="carousel-prev" aria-label="Banner Anterior">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <div class="carousel-dots" id="carousel-dots">
      {%- for block in section.blocks -%}
        <button type="button" 
                class="carousel-dot {% if forloop.first %}is-active{% endif %}" 
                data-dot-index="{{ forloop.index0 }}" 
                aria-label="Ir a diapositiva {{ forloop.index }}">
        </button>
      {%- endfor -%}
    </div>

    <button type="button" class="carousel-btn-arrow" id="carousel-next" aria-label="Siguiente Banner">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>

</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const slides = document.querySelectorAll('.kalpa-slide');
    const dots = document.querySelectorAll('.carousel-dot');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');
    
    if (!slides.length) return;

    let currentIndex = 0;
    let autoPlayTimer = null;

    function goToSlide(index) {
      if (index < 0) index = slides.length - 1;
      if (index >= slides.length) index = 0;

      slides.forEach((s, idx) => {
        s.classList.toggle('is-active', idx === index);
      });

      dots.forEach((d, idx) => {
        d.classList.toggle('is-active', idx === index);
      });

      currentIndex = index;

      // Animar y reaccionar la lata 3D al cambio de diapositiva
      if (window.kallpa3D && typeof window.kallpa3D.transitionSlide === 'function') {
        window.kallpa3D.transitionSlide(currentIndex);
      }
    }

    if (prevBtn) prevBtn.addEventListener('click', () => {
      goToSlide(currentIndex - 1);
      resetAutoPlay();
    });

    if (nextBtn) nextBtn.addEventListener('click', () => {
      goToSlide(currentIndex + 1);
      resetAutoPlay();
    });

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => {
        goToSlide(idx);
        resetAutoPlay();
      });
    });

    function startAutoPlay() {
      autoPlayTimer = setInterval(() => {
        goToSlide(currentIndex + 1);
      }, 6500);
    }

    function resetAutoPlay() {
      clearInterval(autoPlayTimer);
      startAutoPlay();
    }

    startAutoPlay();
  });
</script>

