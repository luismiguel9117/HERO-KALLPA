{{ 'tienda.css' | asset_url | stylesheet_tag }}

<!-- HERO BANNER DE TIENDA -->
<section class="tienda-hero-banner">
  <div class="page-width tienda-hero__container">
    <nav class="tienda-breadcrumb" aria-label="Navegación">
      <a href="{{ routes.root_url }}">Inicio</a>
      <span>/</span>
      <span style="color: #f5ba2c; font-weight: 600;">Tienda</span>
    </nav>

    <h1 class="tienda-hero__title">
      {{ section.settings.title | default: 'TIENDA OFICIAL KALPA' }}
    </h1>
    <p class="tienda-hero__subtitle">
      {{ section.settings.subtitle | default: 'Toda nuestra línea de Cold Brew listo para tomar y Café Molido de especialidad. Elige tu presentación favorita y recíbela directo en tu puerta.' }}
    </p>
  </div>
</section>

<!-- BARRA DE FILTROS Y CONTROLES -->
<section class="tienda-controls-bar" id="catalogo">
  <div class="page-width tienda-controls__inner">
    
    <!-- Filtros a la Izquierda -->
    <div class="tienda-filters-left">
      <button type="button" class="filter-dropdown-btn is-active" data-cat="all" onclick="filterShop('all', this)">
        <span>Todos los productos</span>
      </button>
      <button type="button" class="filter-dropdown-btn" data-cat="cold-brew" onclick="filterShop('cold-brew', this)">
        <span>Cold Brew 355 ml</span>
      </button>
      <button type="button" class="filter-dropdown-btn" data-cat="cafe-molido" onclick="filterShop('cafe-molido', this)">
        <span>Café Molido</span>
      </button>
      <button type="button" class="filter-dropdown-btn" data-cat="packs" onclick="filterShop('packs', this)">
        <span>Packs de Ahorro</span>
      </button>
    </div>

    <!-- Controles a la Derecha -->
    <div class="tienda-controls-right">
      <span class="tienda-items-count" id="tienda-count">5 artículos</span>
      
      <div class="tienda-sort-wrapper">
        <select class="tienda-sort-select" aria-label="Ordenar productos" onchange="sortShop(this.value)">
          <option value="popular">Más vendidos</option>
          <option value="price-asc">Precio: menor a mayor</option>
          <option value="price-desc">Precio: mayor a menor</option>
          <option value="name">Nombre: A - Z</option>
        </select>
        <svg class="tienda-sort-arrow" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>
    </div>

  </div>
</section>

