<script>
  function stepQty(btn, change) {
    const parent = btn.closest('.tienda-qty-stepper');
    const input = parent.querySelector('.qty-input');
    let val = parseInt(input.value) || 1;
    val += change;
    if (val < 1) val = 1;
    if (val > 99) val = 99;
    input.value = val;
  }

  function filterShop(cat, btn) {
    document.querySelectorAll('.filter-dropdown-btn').forEach(b => b.classList.remove('is-active'));
    btn.classList.add('is-active');

    const cards = document.querySelectorAll('.tienda-card');
    let count = 0;
    cards.forEach(card => {
      const cardCat = card.getAttribute('data-category');
      if (cat === 'all' || cardCat === cat) {
        card.style.display = 'flex';
        count++;
      } else {
        card.style.display = 'none';
      }
    });

    const countEl = document.getElementById('tienda-count');
    if (countEl) countEl.textContent = count + ' artículos';
  }

  function sortShop(criteria) {
    const grid = document.getElementById('tienda-grid');
    const cards = Array.from(grid.querySelectorAll('.tienda-card'));

    cards.sort((a, b) => {
      const priceA = parseFloat(a.getAttribute('data-price'));
      const priceB = parseFloat(b.getAttribute('data-price'));
      const nameA = a.getAttribute('data-name');
      const nameB = b.getAttribute('data-name');

      if (criteria === 'price-asc') return priceA - priceB;
      if (criteria === 'price-desc') return priceB - priceA;
      if (criteria === 'name') return nameA.localeCompare(nameB);
      return 0;
    });

    cards.forEach(c => grid.appendChild(c));
  }

  function addToCart(title, price, btn) {
    const card = btn.closest('.tienda-card');
    const qtyInput = card.querySelector('.qty-input');
    const qty = parseInt(qtyInput ? qtyInput.value : 1);

    const origText = btn.innerHTML;
    btn.innerHTML = '<span>✓ Agregado</span>';
    btn.style.background = '#27ae60';
    btn.style.borderColor = '#27ae60';
    btn.style.color = '#fff';

    const cartCountEl = document.getElementById('kallpa-cart-count');
    if (cartCountEl) {
      let current = parseInt(cartCountEl.textContent) || 0;
      cartCountEl.textContent = current + qty;
    }

    if (typeof openKallpaCart === 'function') {
      setTimeout(() => {
        openKallpaCart();
      }, 400);
    }

    setTimeout(() => {
      btn.innerHTML = origText;
      btn.style.background = '';
      btn.style.borderColor = '';
      btn.style.color = '';
    }, 2000);
  }
</script>

