{%- comment -%}
  SECCIÓN: kallpa-ticker.liquid
  Barra de Beneficios de Confianza y Marquee Banner Infinito KALPA
{%- endcomment -%}

<!-- 1. Barra de Beneficios / Badges de Confianza -->
{%- if section.settings.show_features_bar -%}
<section class="kalpa-hero-features-bar">
  <div class="page-width kalpa-hero-features-grid">
    <!-- 1. Granos del VRAEM -->
    <div class="hero-feature-item">
      <div class="hero-feature-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <g transform="rotate(40 12 12)">
            <ellipse cx="12" cy="12" rx="7" ry="10"></ellipse>
            <path d="M12 2c-3.5 4-3.5 6.5 0 10s3.5 6 0 10"></path>
          </g>
        </svg>
      </div>
      <div class="hero-feature-text">
        <span>{{ section.settings.feat1_line1 | default: 'GRANOS' }}</span>
        <span>{{ section.settings.feat1_line2 | default: 'DEL VRAEM' }}</span>
      </div>
    </div>

    <!-- 2. Energía Natural -->
    <div class="hero-feature-item">
      <div class="hero-feature-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
      </div>
      <div class="hero-feature-text">
        <span>{{ section.settings.feat2_line1 | default: 'ENERGÍA' }}</span>
        <span>{{ section.settings.feat2_line2 | default: 'NATURAL' }}</span>
      </div>
    </div>

    <!-- 3. Cold Brew 16H -->
    <div class="hero-feature-item">
      <div class="hero-feature-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <line x1="12" y1="2" x2="12" y2="22"></line>
          <path d="m20 16-4-4 4-4"></path>
          <path d="m4 8 4 4-4 4"></path>
          <path d="m16 4-4 4-4-4"></path>
          <path d="m8 20 4-4 4 4"></path>
        </svg>
      </div>
      <div class="hero-feature-text">
        <span>{{ section.settings.feat3_line1 | default: 'COLD BREW' }}</span>
        <span>{{ section.settings.feat3_line2 | default: '16H' }}</span>
      </div>
    </div>
  </div>
</section>
{%- endif -%}

<!-- 2. Marquee Ticker Banner Infinito -->
<div class="kallpa-ticker-section" id="ticker-section">
  <div class="kallpa-ticker-track">
    <div class="kallpa-ticker-content">
      <span>ENERGÍA DE LOS ANDES</span>
      <span class="ticker-dash">&mdash;&mdash;</span>
      <span>CAFÉ DE ALTURA</span>
      <span class="ticker-dash">&mdash;&mdash;</span>
      <span>SIN AZÚCAR</span>
      <span class="ticker-dash">&mdash;&mdash;</span>
      <span>280 MG DE CAFEÍNA</span>
      <span class="ticker-dash">&mdash;&mdash;</span>
      <span>ENERGÍA DE LOS ANDES</span>
      <span class="ticker-dash">&mdash;&mdash;</span>
      <span>CAFÉ DE ALTURA</span>
      <span class="ticker-dash">&mdash;&mdash;</span>
      <span>SIN AZÚCAR</span>
      <span class="ticker-dash">&mdash;&mdash;</span>
      <span>280 MG DE CAFEÍNA</span>
      <span class="ticker-dash">&mdash;&mdash;</span>
    </div>
    <div class="kallpa-ticker-content" aria-hidden="true">
      <span>ENERGÍA DE LOS ANDES</span>
      <span class="ticker-dash">&mdash;&mdash;</span>
      <span>CAFÉ DE ALTURA</span>
      <span class="ticker-dash">&mdash;&mdash;</span>
      <span>SIN AZÚCAR</span>
      <span class="ticker-dash">&mdash;&mdash;</span>
      <span>280 MG DE CAFEÍNA</span>
      <span class="ticker-dash">&mdash;&mdash;</span>
      <span>ENERGÍA DE LOS ANDES</span>
      <span class="ticker-dash">&mdash;&mdash;</span>
      <span>CAFÉ DE ALTURA</span>
      <span class="ticker-dash">&mdash;&mdash;</span>
      <span>SIN AZÚCAR</span>
      <span class="ticker-dash">&mdash;&mdash;</span>
      <span>280 MG DE CAFEÍNA</span>
      <span class="ticker-dash">&mdash;&mdash;</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Features & Ticker",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_features_bar",
      "label": "Mostrar Barra de Beneficios",
      "default": true
    },
    {
      "type": "text",
      "id": "feat1_line1",
      "label": "Beneficio 1 Línea 1",
      "default": "GRANOS"
    },
    {
      "type": "text",
      "id": "feat1_line2",
      "label": "Beneficio 1 Línea 2",
      "default": "DEL VRAEM"
    },
    {
      "type": "text",
      "id": "feat2_line1",
      "label": "Beneficio 2 Línea 1",
      "default": "ENERGÍA"
    },
    {
      "type": "text",
      "id": "feat2_line2",
      "label": "Beneficio 2 Línea 2",
      "default": "NATURAL"
    },
    {
      "type": "text",
      "id": "feat3_line1",
      "label": "Beneficio 3 Línea 1",
      "default": "COLD BREW"
    },
    {
      "type": "text",
      "id": "feat3_line2",
      "label": "Beneficio 3 Línea 2",
      "default": "16H"
    }
  ],
  "presets": [
    {
      "name": "Features & Ticker"
    }
  ]
}
{% endschema %}
