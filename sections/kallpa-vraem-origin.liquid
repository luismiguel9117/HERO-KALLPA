{%- comment -%}
  SECCIÓN: kallpa-vraem-origin.liquid
  Nuestro Origen: Un Origen Extraordinario (VRAEM)
{%- endcomment -%}

<section class="kallpa-vraem-panorama-section" id="origin-section" style="background-image: url('{{ 'vraem-landscape-bg.webp' | asset_url }}');">
  <div class="vraem-panorama-overlay"></div>
  <div class="page-width vraem-panorama-container">
    
    <!-- Columna Izquierda: Título Editorial, Manifiesto y CTA -->
    <div class="vraem-panorama__left">
      <h2 class="vraem-panorama__title">
        <span class="title-white">{{ section.settings.title_line1 | default: 'UN ORIGEN' }}</span>
        <span class="title-gold">{{ section.settings.title_line2 | default: 'EXTRAORDINARIO' }}</span>
      </h2>
      <p class="vraem-panorama__text">
        {{ section.settings.desc | default: 'El VRAEM es más que un lugar, es el origen de una energía real.<br>Un café que conecta la fuerza de los Andes con tu día a día.' }}
      </p>
      <div class="vraem-panorama__action">
        <a href="{{ section.settings.btn_url | default: '/pages/nosotros' }}" class="btn-vraem-gold">
          <span>{{ section.settings.btn_text | default: 'CONOCE EL VRAEM' }}</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>

    <!-- Columna Derecha: 4 Pilares de Origen con Iconografía Blanca -->
    <div class="vraem-panorama__right">
      <div class="vraem-feature-pill">
        <div class="vraem-feature-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="m8 3 4 8 5-5 5 15H2L8 3z"></path>
          </svg>
        </div>
        <span class="vraem-feature-label">Altura ideal para un gran café</span>
      </div>

      <div class="vraem-feature-pill">
        <div class="vraem-feature-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
            <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
          </svg>
        </div>
        <span class="vraem-feature-label">Cultivo sostenible</span>
      </div>

      <div class="vraem-feature-pill">
        <div class="vraem-feature-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
        </div>
        <span class="vraem-feature-label">Apoyamos a productores locales</span>
      </div>

      <div class="vraem-feature-pill">
        <div class="vraem-feature-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
          </svg>
        </div>
        <span class="vraem-feature-label">Más que café, más personas</span>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Origen VRAEM KALPA",
  "settings": [
    {
      "type": "text",
      "id": "title_line1",
      "label": "Título Línea 1",
      "default": "UN ORIGEN"
    },
    {
      "type": "text",
      "id": "title_line2",
      "label": "Título Línea 2 (Dorado)",
      "default": "EXTRAORDINARIO"
    },
    {
      "type": "textarea",
      "id": "desc",
      "label": "Descripción",
      "default": "El VRAEM es más que un lugar, es el origen de una energía real.<br>Un café que conecta la fuerza de los Andes con tu día a día."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Texto del Botón",
      "default": "CONOCE EL VRAEM"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Enlace del Botón"
    }
  ]
}
{% endschema %}
