      "default": "7.90"
    },
    {
      "type": "text",
      "id": "price_tripack",
      "label": "Precio Tripack (S/)",
      "default": "35.70"
    },
    {
      "type": "text",
      "id": "price_sixpack",
      "label": "Precio Pack x 6 (S/)",
      "default": "39.90"
    },
    {
      "type": "text",
      "id": "price_12pack",
      "label": "Precio 12-pack (S/)",
      "default": "142.80"
    },
    {
      "type": "header",
      "content": "Especificaciones y Qué Lleva"
    },
    {
      "type": "text",
      "id": "specs_what",
