      "default": "Café cold brew de origen peruano, hecho con granos del VRAEM. 280 mg de cafeína natural por lata. Listo para tomar, en cualquier momento y lugar."
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Insignia en Escenario",
      "default": "355 ML — LATA"
    },
    {
      "type": "header",
      "content": "Imágenes del Producto"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Imagen Principal en Escenario"
    },
    {
      "type": "image_picker",
      "id": "thumb_1_image",
      "label": "Miniatura 1 (Frontal)"
    },
    {
      "type": "image_picker",
      "id": "thumb_2_image",
      "label": "Miniatura 2 (Etiqueta)"
    },
    {
      "type": "header",
      "content": "Sabores"
    },
    {
      "type": "text",
      "id": "flavor_1_name",
