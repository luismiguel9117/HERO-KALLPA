{%- comment -%}
  SECCIÓN: main-product.liquid
  Página de Detalle de Producto KALPA: escenario a sangre con galería, compra, ficha (qué lleva, cómo tomarla, nutrición), cross-sell y FAQs
{%- endcomment -%}

{%- liquid
  assign title_display = product.title | default: section.settings.product_title
  comment
    El título se parte en dos líneas: primera palabra en blanco, el resto en dorado
  endcomment
  assign title_words = title_display | split: ' '
  assign title_line_1 = title_words | first
  assign title_line_2 = title_display | remove_first: title_line_1 | strip
  assign desc_display = product.description | strip_html | strip | default: section.settings.product_desc
  assign cat_display = section.settings.category_tag | default: 'BEBIDA FUNCIONAL A BASE DE CAFÉ'
  assign badge_display = product.metafields.custom.sello.value

  comment
    Precios reales del admin: unidad = primera variante que no es pack; pack = variante cuyo
    nombre contiene "x6" (ej. "Pack x 6"). Sin variante pack, el pack cuesta 6 unidades sin descuento.
  endcomment
  assign product_name = product.title | downcase
  assign is_can = false
  if product_name contains 'cold brew' or product_name contains 'lata'
    assign is_can = true
  endif

  assign unit_variant = nil
  assign pack_variant = nil
  for v in product.variants
    assign v_title = v.title | downcase | remove: ' '
    if v_title contains 'pack' or v_title contains 'x6'
      if pack_variant == nil and v_title contains 'x6'
        assign pack_variant = v
      endif
    elsif unit_variant == nil
      assign unit_variant = v
    endif
  endfor
  if unit_variant == nil
    assign unit_variant = product.selected_or_first_available_variant
  endif

  if unit_variant != nil
    assign unit_cents = unit_variant.price
  else
    assign unit_cents = section.settings.price_unit | default: '7.90' | times: 100 | round
  endif
  assign six_regular_cents = unit_cents | times: 6
  if pack_variant != nil
    assign six_cents = pack_variant.price
  else
    assign six_cents = six_regular_cents
  endif
  assign p_six_off = 0
  if six_regular_cents > six_cents
    assign p_six_off = six_regular_cents | minus: six_cents | times: 100 | divided_by: six_regular_cents
  endif

  assign p_unit = unit_cents | money_without_currency
  assign p_sixpack = six_cents | money_without_currency

  assign has_media = false
  if product.media.size > 0
    assign has_media = true
    assign first_image = product.featured_image
  endif
-%}

<section class="pdp" aria-label="{{ title_display }}">

  <!-- 1. ESCENARIO + COMPRA -->
  <div class="pdp-hero{% unless has_media %} pdp-hero--no-media{% endunless %}">

    {%- if has_media -%}
    <!-- Escenario a sangre con la galería del producto (fotos y videos de Shopify) -->
    <div class="pdp-stage" id="product-main-card">
      {%- if first_image != blank -%}
        <img src="{{ first_image | image_url: width: 1600 }}" alt="{{ first_image.alt | default: title_display | escape }}" class="pdp-stage__img" id="main-product-img" width="1600" height="1600" fetchpriority="high">
      {%- else -%}
        <img src="{{ product.media.first.preview_image | image_url: width: 1600 }}" alt="{{ title_display | escape }}" class="pdp-stage__img" id="main-product-img" width="1600" height="1600" fetchpriority="high">
      {%- endif -%}
      <div class="pdp-stage__veil" aria-hidden="true"></div>

      <svg class="pdp-stage__pattern" viewBox="0 0 120 360" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
        {%- for y in (0..2) -%}
          {%- assign cy = y | times: 120 | plus: 60 -%}
          <g transform="translate(60 {{ cy }})" fill="none" stroke="currentColor">
            <path d="M0 -58 L58 0 L0 58 L-58 0 Z" stroke-width="7"/>
            <path d="M0 -38 L38 0 L0 38 L-38 0 Z" stroke-width="6"/>
            <path d="M0 -18 L18 0 L0 18 L-18 0 Z" fill="currentColor" stroke="none"/>
          </g>
        {%- endfor -%}
      </svg>

      {%- if product.media.size > 1 -%}
        <div class="pdp-thumbs" aria-label="Galería del producto">
          {%- for media in product.media limit: 6 -%}
            {%- assign thumb = media.preview_image -%}
            {%- if media.media_type == 'image' -%}
              <button type="button" class="pdp-thumb{% if forloop.first %} is-active{% endif %}" onclick="switchMainImage('{{ media | image_url: width: 1600 }}', this)" aria-label="Foto {{ forloop.index }}">
                <img src="{{ thumb | image_url: width: 160 }}" alt="" width="78" height="92" loading="lazy">
              </button>
            {%- else -%}
              {%- liquid
                if media.media_type == 'external_video'
                  if media.host == 'youtube'
                    assign video_url = 'https://www.youtube.com/watch?v=' | append: media.external_id
                  else
                    assign video_url = 'https://vimeo.com/' | append: media.external_id
                  endif
                else
                  assign video_url = media.sources.first.url
                endif
              -%}
              <button type="button" class="pdp-thumb pdp-thumb--video" onclick="openProductVideo('{{ video_url }}')" aria-label="Ver video">
                <img src="{{ thumb | image_url: width: 160 }}" alt="" width="78" height="92" loading="lazy">
                <span class="pdp-thumb__play" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if badge_display != blank -%}
        <span class="pdp-stage__badge">{{ badge_display }}</span>
      {%- endif -%}
    </div>
    {%- endif -%}

    <!-- Columna de compra -->
    <div class="pdp-info">
      <nav class="pdp-crumbs" aria-label="Ruta">
        <a href="{{ routes.root_url }}">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="{{ routes.all_products_collection_url }}">Productos</a>
        <span aria-hidden="true">›</span>
        <span>{{ title_display }}</span>
      </nav>

      <span class="pdp-eyebrow">{{ cat_display }}</span>
      <h1 class="pdp-title">
        <span>{{ title_line_1 }}</span>
        <span class="pdp-title__gold">{{ title_line_2 }}</span>
      </h1>
      <p class="pdp-lead">{{ desc_display }}</p>

      {%- if is_can -%}
      <ul class="pdp-features">
        <li><span class="pdp-features__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></span>Energía natural</li>
        <li><span class="pdp-features__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg></span>Sin azúcar</li>
        <li><span class="pdp-features__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="m8 3 4 8 5-5 5 11H2L8 3z"/></svg></span>Café de los Andes</li>
        <li><span class="pdp-features__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg></span>0 calorías</li>
      </ul>
      {%- endif -%}

      {%- if is_can -%}
      <div class="pdp-group">
        <span class="pdp-label">PRESENTACIÓN</span>
        <div class="pdp-packs" role="radiogroup" aria-label="Presentación">
          <button type="button" role="radio" aria-checked="true" class="pdp-pack is-active" onclick="selectPack(1, {{ unit_cents | divided_by: 100.0 }}, 'Unidad', this, {{ unit_variant.id | default: 'null' }}, 1)">
            <span class="pdp-pack__radio" aria-hidden="true"></span>
            <span class="pdp-pack__main"><strong>Unidad</strong><small>1 lata · 355 mL</small></span>
            <span class="pdp-pack__price">S/ {{ p_unit }}</span>
          </button>
          <button type="button" role="radio" aria-checked="false" class="pdp-pack" onclick="selectPack(6, {{ six_cents | divided_by: 100.0 }}, 'Pack x 6', this, {{ pack_variant.id | default: unit_variant.id | default: 'null' }}, {% if pack_variant != nil %}1{% else %}6{% endif %})">
            {%- if p_six_off > 0 -%}<span class="pdp-pack__save">-{{ p_six_off }}%</span>{%- endif -%}
            <span class="pdp-pack__radio" aria-hidden="true"></span>
            <span class="pdp-pack__main"><strong>Pack x 6</strong><small>6 latas de 355 mL</small></span>
            <span class="pdp-pack__price">S/ {{ p_sixpack }}{% if p_six_off > 0 %}<s>S/ {{ six_regular_cents | money_without_currency }}</s>{% endif %}</span>
          </button>
        </div>
      {%- elsif product.has_only_default_variant == false -%}
      <div class="pdp-group">
        <span class="pdp-label">{{ product.options.first | upcase }}</span>
        <div class="pdp-packs" role="radiogroup" aria-label="{{ product.options.first | escape }}">
          {%- for v in product.variants -%}
            {%- assign v_off = 0 -%}
            {%- if v.compare_at_price > v.price -%}
              {%- assign v_off = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price -%}
            {%- endif -%}
            <button type="button" role="radio" aria-checked="{% if v == unit_variant %}true{% else %}false{% endif %}" class="pdp-pack{% if v == unit_variant %} is-active{% endif %}"{% unless v.available %} disabled{% endunless %} onclick="selectPack(1, {{ v.price | divided_by: 100.0 }}, {{ v.title | json | escape }}, this, {{ v.id }}, 1)">
              {%- if v_off > 0 -%}<span class="pdp-pack__save">-{{ v_off }}%</span>{%- endif -%}
              <span class="pdp-pack__radio" aria-hidden="true"></span>
              <span class="pdp-pack__main"><strong>{{ v.title }}</strong>{% unless v.available %}<small>Agotado</small>{% endunless %}</span>
              <span class="pdp-pack__price">S/ {{ v.price | money_without_currency }}{% if v_off > 0 %}<s>S/ {{ v.compare_at_price | money_without_currency }}</s>{% endif %}</span>
            </button>
          {%- endfor -%}
        </div>
      </div>
      {%- endif -%}
      </div>

      <div class="pdp-group">
        <span class="pdp-label">CANTIDAD</span>
        <div class="pdp-buy">
          <div class="pdp-qty">
            <button type="button" onclick="changeQty(-1)" aria-label="Quitar uno">−</button>
            <span id="pdp-qty-val" aria-live="polite">1</span>
            <button type="button" onclick="changeQty(1)" aria-label="Agregar uno">+</button>
          </div>
          <button type="button" class="pdp-add" id="btn-add-main" onclick="handleAddToCart()">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
            <span id="btn-add-label">AGREGAR AL CARRITO – S/ {{ p_unit }}</span>
          </button>
        </div>
      </div>

      <div class="pdp-trust">
        <div class="pdp-trust__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>Envíos a todo el Perú</div>
        <div class="pdp-trust__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l1-5h16l1 5"/><path d="M4 9v11h16V9"/><path d="M3 9h18"/><path d="M9 20v-6h6v6"/></svg>También disponible en Rappi Turbo</div>
        <div class="pdp-trust__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>Compra segura y garantizada</div>
      </div>
    </div>
  </div>

  {%- liquid
    assign spec_what = product.metafields.custom.que_lleva.value
    assign spec_ingredients = product.metafields.custom.ingredientes.value
    assign spec_prep = product.metafields.custom.preparacion.value
  -%}
  {%- if is_can -%}
  <!-- 2. FICHA: QUÉ LLEVA · CÓMO TOMARLA · NUTRICIÓN -->
  <div class="pdp-specs">
    <div class="pdp-specs__grid">
      <div class="pdp-specs__col">
        <h3 class="pdp-specs__title">QUÉ LLEVA</h3>
        <p class="pdp-specs__headline">{{ section.settings.specs_what | default: 'Café cold brew listo para tomar, macerado en frío durante 24 horas.' }}</p>
        <p class="pdp-specs__text"><strong>Ingredientes:</strong> {{ section.settings.specs_ingredients | default: 'agua tratada, café de especialidad de Ayacucho y stevia natural.' }}</p>
        <p class="pdp-specs__warning"><strong>{{ section.settings.warning_title | default: 'ALTO EN CAFEÍNA' }}.</strong> {{ section.settings.warning_text | default: 'No recomendado para niños, mujeres embarazadas o personas con extrema sensibilidad a la cafeína.' }}</p>
      </div>

      <div class="pdp-specs__col">
        <h3 class="pdp-specs__title">CÓMO TOMARLA</h3>
        <ul class="pdp-howto">
          <li><span class="pdp-howto__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><line x1="12" y1="2" x2="12" y2="22"/><line x1="3.3" y1="7" x2="20.7" y2="17"/><line x1="3.3" y1="17" x2="20.7" y2="7"/><polyline points="9 4 12 6 15 4"/><polyline points="9 20 12 18 15 20"/></svg></span>Tómala bien helada</li>
          <li><span class="pdp-howto__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><rect x="7" y="3" width="10" height="18" rx="2"/><line x1="7" y1="7" x2="17" y2="7"/><line x1="7" y1="17" x2="17" y2="17"/></svg></span>Sola o con hielo</li>
          <li><span class="pdp-howto__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></span>En cualquier momento del día</li>
        </ul>
      </div>

      <div class="pdp-specs__col">
        <h3 class="pdp-specs__title">INFORMACIÓN NUTRICIONAL</h3>
        <table class="pdp-nutrition">
          <thead><tr><th>Nutriente</th><th>Por porción ({{ section.settings.specs_net_content | default: '355 mL' }})</th></tr></thead>
          <tbody>
            <tr><td>Energía</td><td>0 kcal / 0 kJ</td></tr>
            <tr><td>Grasas totales</td><td>0 g</td></tr>
            <tr><td>Carbohidratos totales</td><td>0 g</td></tr>
            <tr><td>Azúcares añadidos</td><td>0 g</td></tr>
            <tr><td>Proteína</td><td>0 g</td></tr>
            <tr><td>Cafeína</td><td>280 mg</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  {%- elsif spec_what != blank or spec_ingredients != blank or spec_prep != blank -%}
  <!-- 2. FICHA DEL PRODUCTO (metacampos custom.que_lleva / custom.ingredientes / custom.preparacion) -->
  <div class="pdp-specs">
    <div class="pdp-specs__grid pdp-specs__grid--two">
      {%- if spec_what != blank or spec_ingredients != blank -%}
        <div class="pdp-specs__col">
          <h3 class="pdp-specs__title">QUÉ LLEVA</h3>
          {%- if spec_what != blank -%}<p class="pdp-specs__headline">{{ spec_what }}</p>{%- endif -%}
          {%- if spec_ingredients != blank -%}<p class="pdp-specs__text"><strong>Ingredientes:</strong> {{ spec_ingredients }}</p>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if spec_prep != blank -%}
        <div class="pdp-specs__col">
          <h3 class="pdp-specs__title">CÓMO PREPARARLO</h3>
          <p class="pdp-specs__text">{{ spec_prep }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>
  {%- endif -%}
</section>

<!-- 4. CROSS-SELL: otros productos reales de la tienda -->
{%- liquid
  assign cross_count = 0
  for p in collections.all.products
    if p.id != product.id and p.available
      assign cross_count = cross_count | plus: 1
    endif
  endfor
-%}
{%- if cross_count > 0 -%}
<section class="product-cross-section" id="cross-sell-section">
  <div class="page-width">
    <span class="cross-eyebrow">COMPLETA TU PEDIDO</span>
    <h2 class="cross-title">{{ section.settings.cross_title | default: 'QUE NO SE TE ACABE A MITAD DE SEMANA' }}</h2>

    <div class="cross-cards-grid">
      {%- assign shown = 0 -%}
      {%- for p in collections.all.products -%}
        {%- if p.id == product.id or p.available == false -%}{%- continue -%}{%- endif -%}
        {%- if shown >= 2 -%}{%- break -%}{%- endif -%}
        {%- assign shown = shown | plus: 1 -%}
        {%- assign cv = p.selected_or_first_available_variant -%}
        <div class="cross-pack-card">
          {%- if p.featured_image != blank -%}
            <a href="{{ p.url }}"><img src="{{ p.featured_image | image_url: width: 280 }}" alt="{{ p.featured_image.alt | default: p.title | escape }}" class="cross-pack-img" width="80" height="95" loading="lazy"></a>
          {%- endif -%}
          <div class="cross-pack-info">
            <a href="{{ p.url }}" class="cross-pack-name">{{ p.title }}</a>
            {%- unless p.has_only_default_variant -%}<span class="cross-pack-sub">{{ cv.title }}</span>{%- endunless -%}
            <span class="cross-pack-price">S/ {{ cv.price | money_without_currency }}</span>
            <button type="button" class="btn-cross-add" onclick="addVariantToKallpaCart({{ cv.id }}, 1)">
              AGREGAR
            </button>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

<!-- 5. PREGUNTAS FRECUENTES (FAQ) -->
<section class="product-faq-section">
  <div class="page-width">
    <span class="faq-eyebrow">{{ section.settings.faq_eyebrow | default: 'PREGUNTAS FRECUENTES' }}</span>
    <h2 class="faq-title">{{ section.settings.faq_title | default: 'ANTES DE COMPRAR' }}</h2>

    <div class="faq-accordion">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq_item' -%}
            <div class="faq-item{% if block.settings.open_by_default %} is-open{% endif %}" {{ block.shopify_attributes }}>
              <button type="button" class="faq-header" onclick="toggleFaq(this)">
                <span>{{ block.settings.question }}</span>
                <span class="faq-icon">+</span>
              </button>
              <div class="faq-body">
                {{ block.settings.answer }}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <div class="faq-item is-open">
          <button type="button" class="faq-header" onclick="toggleFaq(this)">
            <span>¿Cuánta cafeína tiene?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-body">
            Cada lata de 355 ml contiene 280 mg de cafeína natural pura, extraída lentamente en frío durante 24 horas continuas a 4°C. Equivale a aproximadamente 3 espressos pero con liberación prolongada gracias a los polifenoles del café.
          </div>
        </div>

        <div class="faq-item">
          <button type="button" class="faq-header" onclick="toggleFaq(this)">
            <span>¿Quién no debería tomarla?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-body">
            Debido a su alta concentración de cafeína natural, no está recomendada para niños, personas gestantes o en período de lactancia, ni personas con alta sensibilidad a los estimulantes o afecciones cardíacas.
          </div>
        </div>

        <div class="faq-item">
          <button type="button" class="faq-header" onclick="toggleFaq(this)">
            <span>¿Envían a provincia?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-body">
            Sí. Despachamos a todas las ciudades y provincias del Perú a través de Olva Courier y Shalom, con empaque protector anti-impacto. El tiempo promedio de entrega en Lima es de 24 a 48 horas, y en provincias de 48 a 72 horas hábiles.
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  function switchMainImage(src, btn) {
    var img = document.getElementById('main-product-img');
    if (img) {
      img.src = src;
      img.classList.toggle('is-contain', btn.getAttribute('data-fit') === 'contain');
    }
    document.querySelectorAll('.pdp-thumb').forEach(function(b) { b.classList.remove('is-active'); });
    btn.classList.add('is-active');
  }

  function openProductVideo(url) {
    if (typeof window.openReelModal === 'function') {
      window.openReelModal(url);
    } else {
      window.open(url, '_blank', 'noopener,noreferrer');
    }
  }

  var currentPackQty = 1;
  var currentPackPrice = {{ unit_cents | divided_by: 100.0 }};
  var currentPackName = 'Unidad';
  var currentVariantId = {{ unit_variant.id | default: 'null' }};
  var currentUnitsPerAdd = 1;
  var currentCount = 1;

  function updateAddLabel() {
    var label = document.getElementById('btn-add-label');
    if (label) label.textContent = 'AGREGAR AL CARRITO – S/ ' + (currentPackPrice * currentCount).toFixed(2);
  }

  function selectPack(qty, price, name, btn, variantId, unitsPerAdd) {
    currentPackQty = qty;
    currentPackPrice = price;
    currentPackName = name;
    currentVariantId = variantId;
    currentUnitsPerAdd = unitsPerAdd || 1;
    document.querySelectorAll('.pdp-pack').forEach(function(b) {
      b.classList.remove('is-active');
      b.setAttribute('aria-checked', 'false');
    });
    btn.classList.add('is-active');
    btn.setAttribute('aria-checked', 'true');
    updateAddLabel();
  }

  function changeQty(delta) {
    currentCount = Math.max(1, Math.min(99, currentCount + delta));
    var el = document.getElementById('pdp-qty-val');
    if (el) el.textContent = currentCount;
    updateAddLabel();
  }

  function handleAddToCart() {
    var title = '{{ title_display | escape }} (' + currentPackName + (currentCount > 1 ? ' x' + currentCount : '') + ')';
    // Con variante "Pack x 6" se agrega 1 pack por cada unidad del contador; sin ella, 6 latas sueltas
    var units = currentUnitsPerAdd * currentCount;
    if (typeof window.addPackToKallpaCart === 'function') {
      window.addPackToKallpaCart('pdp-' + currentPackQty, title, currentPackPrice * currentCount, units, currentVariantId);
    } else if (typeof window.openKallpaCart === 'function') {
      window.openKallpaCart();
    }
  }

  function toggleFaq(btn) {
    var item = btn.closest('.faq-item');
    if (item) {
      item.classList.toggle('is-open');
    }
  }
</script>

