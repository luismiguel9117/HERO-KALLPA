      "default": "Café cold brew listo para tomar, macerado en frío durante 24 horas."
    },
    {
      "type": "textarea",
      "id": "specs_ingredients",
      "label": "Ingredientes",
      "default": "agua tratada, café de especialidad de Ayacucho y stevia natural."
    },
    {
      "type": "text",
      "id": "specs_net_content",
      "label": "Contenido Neto",
      "default": "355 ml."
    },
    {
      "type": "textarea",
      "id": "specs_how_to_drink",
