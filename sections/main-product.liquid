{%- comment -%}
  SECCIÓN: main-product.liquid
  Página de Detalle de Producto KALPA. Un solo diseño, el de la lata Cold Brew, para todos los
  productos: escenario con galería, compra, ficha (qué lleva, cómo tomarla, nutrición),
  cross-sell y FAQs. Solo cambia la información:

  1. Los textos viven en los ajustes de esta sección (editor de temas). La plantilla "product"
     tiene los de Cold Brew; cada tipo de producto usa su propia plantilla (ej. product.cafe-molido)
     con la misma estructura y sus textos.
  2. Si un producto tiene metacampos propios (namespace "custom"), estos reemplazan al ajuste:
     categoria, sello, caracteristicas (lista), contenido, envase, que_lleva, ingredientes,
     advertencia_titulo, advertencia, titulo_preparacion, como_tomarla (lista), nutricion
     (una fila por línea "Energía: 0 kcal"), preguntas (una por línea "¿Pregunta? | Respuesta"),
     ficha_1 … ficha_4 (galería; si no hay, se usan las fotos del producto).
{%- endcomment -%}

{%- liquid
  assign mf = product.metafields.custom
  assign ss = section.settings
  assign title_display = product.title | default: ss.product_title
  # El título se parte en dos líneas: primera palabra en blanco, el resto en dorado
  assign title_words = title_display | split: ' '
  assign title_line_1 = title_words | first
  assign title_line_2 = title_display | remove_first: title_line_1 | strip

  # Cada texto: metacampo del producto o, si no tiene, el ajuste de la plantilla
  assign desc_display = product.description | strip_html | strip | default: ss.product_desc
  assign cat_display = mf.categoria.value | default: ss.category_tag | default: product.type
  assign badge_display = mf.sello.value | default: ss.badge_text
  # Contenido neto: metacampo, el que dice el nombre ("Café Molido 500 g" → 500 g) o el de la plantilla
  assign net_content = mf.contenido.value
  if net_content == blank
    assign title_tokens = product.title | downcase | split: ' '
    for token in title_tokens
      assign token_number = token | plus: 0
      assign next_token = title_tokens[forloop.index]
      if token_number > 0 and next_token == 'g' or token_number > 0 and next_token == 'ml'
        assign net_content = token | append: ' ' | append: next_token | replace: ' ml', ' mL'
        break
      endif
      assign unit_g = token | slice: -1
      assign unit_ml = token | slice: -2, 2
      if token_number > 0 and unit_g == 'g' or token_number > 0 and unit_ml == 'ml'
        assign net_content = token | replace: 'ml', ' mL' | replace: 'g', ' g'
        break
      endif
    endfor
  endif
  if net_content == blank
    assign net_content = ss.net_content
  endif
  assign container_name = mf.envase.value | default: ss.container | downcase
  assign container_plural = container_name | append: 's'

  # Variante inicial: la primera que no es pack y tiene stock; si no, la primera
  assign unit_variant = nil
  for v in product.variants
    assign v_title = v.title | downcase | remove: ' '
    unless v_title contains 'pack'
      assign unit_variant = v
      break
    endunless
  endfor
  if unit_variant == nil
    assign unit_variant = product.variants.first
  endif
  assign start_variant = unit_variant
  unless start_variant.available
    assign start_variant = product.selected_or_first_available_variant
  endunless

  # Galería: archivos de los metacampos ficha_1…ficha_4; si no hay, las fotos del producto
  assign slot_count = 0
  for n in (1..4)
    assign slot_key = 'ficha_' | append: n
    if mf[slot_key].value != blank
      assign slot_count = slot_count | plus: 1
    endif
  endfor
  assign media_count = slot_count
  if slot_count == 0
    assign media_count = product.media.size
    if media_count > 4
      assign media_count = 4
    endif
  endif
-%}

<section class="pdp" aria-label="{{ title_display }}">

  <!-- 1. ESCENARIO + COMPRA -->
  <div class="pdp-hero{% if media_count == 0 %} pdp-hero--no-media{% endif %}">

    {%- if media_count > 0 -%}
    <div class="pdp-stage" id="product-main-card">
      {%- assign media_index = 0 -%}
      {%- if slot_count > 0 -%}
        {%- for n in (1..4) -%}
          {%- assign slot_key = 'ficha_' | append: n -%}
          {%- assign file = mf[slot_key].value -%}
          {%- if file == blank -%}{%- continue -%}{%- endif -%}
          {%- render 'pdp-media', file: file, index: media_index, mode: 'slide', title: title_display -%}
          {%- assign media_index = media_index | plus: 1 -%}
        {%- endfor -%}
      {%- else -%}
        {%- for media in product.media limit: 4 -%}
          {%- render 'pdp-media', file: media, index: forloop.index0, mode: 'slide', title: title_display -%}
        {%- endfor -%}
      {%- endif -%}

      <div class="pdp-stage__veil" aria-hidden="true"></div>

      {%- if media_count > 1 -%}
        <div class="pdp-thumbs" aria-label="Galería del producto">
          {%- assign media_index = 0 -%}
          {%- if slot_count > 0 -%}
            {%- for n in (1..4) -%}
              {%- assign slot_key = 'ficha_' | append: n -%}
              {%- assign file = mf[slot_key].value -%}
              {%- if file == blank -%}{%- continue -%}{%- endif -%}
              {%- render 'pdp-media', file: file, index: media_index, mode: 'thumb', title: title_display -%}
              {%- assign media_index = media_index | plus: 1 -%}
            {%- endfor -%}
          {%- else -%}
            {%- for media in product.media limit: 4 -%}
              {%- render 'pdp-media', file: media, index: forloop.index0, mode: 'thumb', title: title_display -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if badge_display != blank -%}
        <span class="pdp-stage__badge">{{ badge_display }}</span>
      {%- endif -%}
    </div>
    {%- endif -%}

    <!-- Columna de compra -->
    <div class="pdp-info">
      <nav class="pdp-crumbs" aria-label="Ruta">
        <a href="{{ routes.root_url }}">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="{{ routes.all_products_collection_url }}">Tienda</a>
        <span aria-hidden="true">›</span>
        <span>{{ title_display }}</span>
      </nav>

      {%- if cat_display != blank -%}
        <span class="pdp-eyebrow">{{ cat_display }}</span>
      {%- endif -%}
      <h1 class="pdp-title">
        <span>{{ title_line_1 }}</span>
        <span class="pdp-title__gold">{{ title_line_2 }}</span>
      </h1>
      {%- if desc_display != blank -%}
        <p class="pdp-lead">{{ desc_display }}</p>
      {%- endif -%}

      {%- liquid
        assign features = mf.caracteristicas.value
        if features == blank
          assign features = ss.feature_1 | append: '|' | append: ss.feature_2 | append: '|' | append: ss.feature_3 | append: '|' | append: ss.feature_4 | split: '|'
        endif
      -%}
      {%- if features != blank -%}
        <ul class="pdp-features">
          {%- for feature in features limit: 4 -%}
            {%- if feature == blank -%}{%- continue -%}{%- endif -%}
            {%- assign icon_slot = forloop.index0 | modulo: 4 -%}
            <li>
              <span class="pdp-features__icon">
                {%- case icon_slot -%}
                  {%- when 0 -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                  {%- when 1 -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
                  {%- when 2 -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="m8 3 4 8 5-5 5 11H2L8 3z"/></svg>
                  {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                {%- endcase -%}
              </span>
              {{ feature }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="pdp-group">
        <span class="pdp-label">PRESENTACIÓN</span>
        <div class="pdp-packs" role="radiogroup" aria-label="Presentación">
          {%- for v in product.variants -%}
            {%- liquid
              # Unidades de la variante: "Pack x 6" = 6; cualquier otra = 1
              assign v_units = 1
              assign v_title = v.title | downcase | remove: ' '
              if v_title contains 'x'
                assign v_after_x = v_title | split: 'x' | last | plus: 0
                if v_after_x > 1
                  assign v_units = v_after_x
                endif
              endif

              # Descuento: precio de comparación o, para un pack, la unidad por N
              assign v_regular = v.compare_at_price | default: 0
              if v_regular <= v.price and v_units > 1
                assign v_regular = unit_variant.price | times: v_units
              endif
              assign v_off = 0
              if v_regular > v.price
                assign v_off = v_regular | minus: v.price | times: 100 | divided_by: v_regular
              endif

              assign v_name = v.title
              if product.has_only_default_variant
                assign v_name = 'Unidad'
              endif

              assign v_detail = ''
              if container_name != blank
                if v_units > 1
                  assign v_detail = v_units | append: ' ' | append: container_plural
                  if net_content != blank
                    assign v_detail = v_detail | append: ' de ' | append: net_content
                  endif
                else
                  assign v_detail = '1 ' | append: container_name
                  if net_content != blank
                    assign v_detail = v_detail | append: ' · ' | append: net_content
                  endif
                endif
              elsif net_content != blank
                assign v_detail = net_content
                if v_units > 1
                  assign v_detail = v_units | append: ' × ' | append: net_content
                endif
              endif
            -%}
            <button type="button" role="radio"
                    aria-checked="{% if v.id == start_variant.id %}true{% else %}false{% endif %}"
                    class="pdp-pack{% if v.id == start_variant.id %} is-active{% endif %}"
                    data-variant-id="{{ v.id }}"
                    data-price="{{ v.price }}"
                    data-available="{{ v.available }}"
                    onclick="selectPack(this)">
              {%- if v_off > 0 -%}<span class="pdp-pack__save">-{{ v_off }}%</span>{%- endif -%}
              <span class="pdp-pack__radio" aria-hidden="true"></span>
              <span class="pdp-pack__main">
                <strong>{{ v_name }}</strong>
                {%- if v.available == false -%}
                  <small>Agotado</small>
                {%- elsif v_detail != blank -%}
                  <small>{{ v_detail }}</small>
                {%- endif -%}
              </span>
              <span class="pdp-pack__price">S/ {{ v.price | money_without_currency }}{% if v_off > 0 %}<s>S/ {{ v_regular | money_without_currency }}</s>{% endif %}</span>
            </button>
          {%- endfor -%}
        </div>
      </div>

      <div class="pdp-group">
        <span class="pdp-label">CANTIDAD</span>
        <div class="pdp-buy">
          <div class="pdp-qty">
            <button type="button" onclick="changeQty(-1)" aria-label="Quitar uno">−</button>
            <span id="pdp-qty-val" aria-live="polite">1</span>
            <button type="button" onclick="changeQty(1)" aria-label="Agregar uno">+</button>
          </div>
          <button type="button" class="pdp-add" id="btn-add-main" onclick="handleAddToCart()"{% unless start_variant.available %} disabled{% endunless %}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
            <span id="btn-add-label">{% if start_variant.available %}AGREGAR AL CARRITO – S/ {{ start_variant.price | money_without_currency }}{% else %}AGOTADO{% endif %}</span>
          </button>
        </div>
      </div>

      <div class="pdp-trust">
        <div class="pdp-trust__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>Envíos a todo el Perú</div>
        <div class="pdp-trust__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l1-5h16l1 5"/><path d="M4 9v11h16V9"/><path d="M3 9h18"/><path d="M9 20v-6h6v6"/></svg>También disponible en Rappi Turbo</div>
        <div class="pdp-trust__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>Compra segura y garantizada</div>
      </div>
    </div>
  </div>

  {%- liquid
    assign spec_what = mf.que_lleva.value | default: ss.specs_what
    assign spec_ingredients = mf.ingredientes.value | default: ss.specs_ingredients
    assign spec_warning_title = mf.advertencia_titulo.value | default: ss.warning_title
    assign spec_warning = mf.advertencia.value | default: ss.warning_text
    assign spec_prep_title = mf.titulo_preparacion.value | default: ss.howto_title | default: 'CÓMO TOMARLA'
    assign spec_prep = mf.preparacion.value

    assign spec_howto = mf.como_tomarla.value
    if spec_howto == blank and spec_prep == blank
      assign spec_howto = ss.howto_1 | append: '|' | append: ss.howto_2 | append: '|' | append: ss.howto_3 | split: '|'
    endif

    assign nutrition_source = mf.nutricion.value | default: ss.nutrition
    assign nutrition_rows = nutrition_source | newline_to_br | split: '<br />'

    assign spec_cols = 0
    if spec_what != blank or spec_ingredients != blank or spec_warning != blank
      assign spec_cols = spec_cols | plus: 1
    endif
    if spec_howto != blank or spec_prep != blank
      assign spec_cols = spec_cols | plus: 1
    endif
    if nutrition_rows.size > 0
      assign spec_cols = spec_cols | plus: 1
    endif
  -%}
  {%- if spec_cols > 0 -%}
  <!-- 2. FICHA: QUÉ LLEVA · CÓMO TOMARLA · NUTRICIÓN -->
  <div class="pdp-specs">
    <div class="pdp-specs__grid{% if spec_cols < 3 %} pdp-specs__grid--two{% endif %}">
      {%- if spec_what != blank or spec_ingredients != blank or spec_warning != blank -%}
        <div class="pdp-specs__col">
          <h3 class="pdp-specs__title">QUÉ LLEVA</h3>
          {%- if spec_what != blank -%}<p class="pdp-specs__headline">{{ spec_what }}</p>{%- endif -%}
          {%- if spec_ingredients != blank -%}<p class="pdp-specs__text"><strong>Ingredientes:</strong> {{ spec_ingredients }}</p>{%- endif -%}
          {%- if spec_warning != blank -%}
            <p class="pdp-specs__warning">{% if spec_warning_title != blank %}<strong>{{ spec_warning_title }}.</strong> {% endif %}{{ spec_warning }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if spec_howto != blank or spec_prep != blank -%}
        <div class="pdp-specs__col">
          <h3 class="pdp-specs__title">{{ spec_prep_title }}</h3>
          {%- if spec_howto != blank -%}
            <ul class="pdp-howto">
              {%- for step in spec_howto limit: 4 -%}
                {%- if step == blank -%}{%- continue -%}{%- endif -%}
                {%- assign icon_slot = forloop.index0 | modulo: 3 -%}
                <li>
                  <span class="pdp-howto__icon">
                    {%- case icon_slot -%}
                      {%- when 0 -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><line x1="12" y1="2" x2="12" y2="22"/><line x1="3.3" y1="7" x2="20.7" y2="17"/><line x1="3.3" y1="17" x2="20.7" y2="7"/><polyline points="9 4 12 6 15 4"/><polyline points="9 20 12 18 15 20"/></svg>
                      {%- when 1 -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><rect x="7" y="3" width="10" height="18" rx="2"/><line x1="7" y1="7" x2="17" y2="7"/><line x1="7" y1="17" x2="17" y2="17"/></svg>
                      {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                    {%- endcase -%}
                  </span>
                  {{ step }}
                </li>
              {%- endfor -%}
            </ul>
          {%- else -%}
            <p class="pdp-specs__text">{{ spec_prep | newline_to_br }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if nutrition_rows.size > 0 -%}
        <div class="pdp-specs__col">
          <h3 class="pdp-specs__title">INFORMACIÓN NUTRICIONAL</h3>
          <table class="pdp-nutrition">
            <thead><tr><th>Nutriente</th><th>Por porción{% if net_content != blank %} ({{ net_content }}){% endif %}</th></tr></thead>
            <tbody>
              {%- for row in nutrition_rows -%}
                {%- assign row_clean = row | strip -%}
                {%- if row_clean == blank -%}{%- continue -%}{%- endif -%}
                {%- assign row_name = row_clean | split: ':' | first | strip -%}
                {%- assign row_value = row_clean | remove_first: row_name | remove_first: ':' | strip -%}
                <tr><td>{{ row_name }}</td><td>{{ row_value }}</td></tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      {%- endif -%}
    </div>
  </div>
  {%- endif -%}
</section>

<!-- 4. CROSS-SELL: otros productos reales de la tienda -->
{%- liquid
  assign cross_count = 0
  for p in collections.all.products
    if p.id != product.id and p.available
      assign cross_count = cross_count | plus: 1
    endif
  endfor
-%}
{%- if cross_count > 0 -%}
<section class="product-cross-section" id="cross-sell-section">
  <div class="page-width">
    <span class="cross-eyebrow">COMPLETA TU PEDIDO</span>
    <h2 class="cross-title">{{ section.settings.cross_title | default: 'QUE NO SE TE ACABE A MITAD DE SEMANA' }}</h2>

    <div class="cross-cards-grid">
      {%- assign shown = 0 -%}
      {%- for p in collections.all.products -%}
        {%- if p.id == product.id or p.available == false -%}{%- continue -%}{%- endif -%}
        {%- if shown >= 2 -%}{%- break -%}{%- endif -%}
        {%- assign shown = shown | plus: 1 -%}
        {%- assign cv = p.selected_or_first_available_variant -%}
        <div class="cross-pack-card">
          {%- if p.featured_image != blank -%}
            <a href="{{ p.url }}"><img src="{{ p.featured_image | image_url: width: 280 }}" alt="{{ p.featured_image.alt | default: p.title | escape }}" class="cross-pack-img" width="80" height="95" loading="lazy"></a>
          {%- endif -%}
          <div class="cross-pack-info">
            <a href="{{ p.url }}" class="cross-pack-name">{{ p.title }}</a>
            {%- unless p.has_only_default_variant -%}<span class="cross-pack-sub">{{ cv.title }}</span>{%- endunless -%}
            <span class="cross-pack-price">S/ {{ cv.price | money_without_currency }}</span>
            <button type="button" class="btn-cross-add" onclick="addVariantToKallpaCart({{ cv.id }}, 1)">
              AGREGAR
            </button>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

<!-- 5. PREGUNTAS FRECUENTES (FAQ): metacampo "preguntas" del producto o los bloques de la plantilla -->
{%- liquid
  assign faq_lines = mf.preguntas.value | newline_to_br | split: '<br />'
  assign has_product_faq = false
  for line in faq_lines
    if line contains '|'
      assign has_product_faq = true
      break
    endif
  endfor
  assign show_faq = has_product_faq
  if section.blocks.size > 0
    assign show_faq = true
  endif
-%}
{%- if show_faq -%}
<section class="product-faq-section">
  <div class="page-width">
    <span class="faq-eyebrow">{{ section.settings.faq_eyebrow | default: 'PREGUNTAS FRECUENTES' }}</span>
    <h2 class="faq-title">{{ section.settings.faq_title | default: 'ANTES DE COMPRAR' }}</h2>

    <div class="faq-accordion">
      {%- if has_product_faq -%}
        {%- assign faq_index = 0 -%}
        {%- for line in faq_lines -%}
          {%- unless line contains '|' -%}{%- continue -%}{%- endunless -%}
          {%- assign faq_question = line | split: '|' | first | strip -%}
          {%- assign faq_answer = line | remove_first: faq_question | remove_first: '|' | strip -%}
          <div class="faq-item{% if faq_index == 0 %} is-open{% endif %}">
            <button type="button" class="faq-header" onclick="toggleFaq(this)">
              <span>{{ faq_question }}</span>
              <span class="faq-icon">+</span>
            </button>
            <div class="faq-body">{{ faq_answer }}</div>
          </div>
          {%- assign faq_index = faq_index | plus: 1 -%}
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq_item' -%}
            <div class="faq-item{% if block.settings.open_by_default %} is-open{% endif %}" {{ block.shopify_attributes }}>
              <button type="button" class="faq-header" onclick="toggleFaq(this)">
                <span>{{ block.settings.question }}</span>
                <span class="faq-icon">+</span>
              </button>
              <div class="faq-body">
                {{ block.settings.answer }}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

<script>
  function showProductSlide(index, btn) {
    document.querySelectorAll('.pdp-slide').forEach(function(slide) {
      var active = Number(slide.getAttribute('data-slide')) === index;
      slide.classList.toggle('is-active', active);
      var video = slide.querySelector('video');
      if (!video) return;
      if (active) {
        video.play().catch(function() {});
      } else {
        video.pause();
      }
    });
    document.querySelectorAll('.pdp-thumb').forEach(function(b) { b.classList.remove('is-active'); });
    btn.classList.add('is-active');
  }

  var currentVariantId = {{ start_variant.id | default: 'null' }};
  var currentPriceCents = {{ start_variant.price | default: 0 }};
  var currentAvailable = {{ start_variant.available | default: false }};
  var currentCount = 1;

  function updateAddButton() {
    var btn = document.getElementById('btn-add-main');
    var label = document.getElementById('btn-add-label');
    if (btn) btn.disabled = !currentAvailable;
    if (label) {
      label.textContent = currentAvailable
        ? 'AGREGAR AL CARRITO – S/ ' + (currentPriceCents * currentCount / 100).toFixed(2)
        : 'AGOTADO';
    }
  }

  function selectPack(btn) {
    currentVariantId = Number(btn.getAttribute('data-variant-id'));
    currentPriceCents = Number(btn.getAttribute('data-price'));
    currentAvailable = btn.getAttribute('data-available') === 'true';
    document.querySelectorAll('.pdp-pack').forEach(function(b) {
      b.classList.remove('is-active');
      b.setAttribute('aria-checked', 'false');
    });
    btn.classList.add('is-active');
    btn.setAttribute('aria-checked', 'true');
    updateAddButton();
  }

  function changeQty(delta) {
    currentCount = Math.max(1, Math.min(99, currentCount + delta));
    var el = document.getElementById('pdp-qty-val');
    if (el) el.textContent = currentCount;
    updateAddButton();
  }

  function handleAddToCart() {
    if (!currentAvailable || !currentVariantId || typeof window.addVariantToKallpaCart !== 'function') return;
    window.addVariantToKallpaCart(currentVariantId, currentCount).catch(function() {});
  }

  function toggleFaq(btn) {
    var item = btn.closest('.faq-item');
    if (item) {
      item.classList.toggle('is-open');
    }
  }
</script>

