{%- comment -%}
  SECCIÓN: page-nosotros.liquid
  Página de Historia, Origen VRAEM y Manifiesto KALPA (Pixel-Perfect con nosotros.html)
{%- endcomment -%}

<!-- 1. HERO NOSOTROS: EL ARCO ANDINO -->
<section class="nosotros-hero" aria-label="Hero Nosotros">
  <div class="nosotros-hero__bg" aria-hidden="true"></div>
  <div class="nosotros-hero__arch" aria-hidden="true"></div>
  <div class="nosotros-hero__vignette" aria-hidden="true"></div>

  <!-- Lata flotando recta sobre la roca, dentro del arco de luz -->
  <div class="nosotros-hero__can-wrap" aria-hidden="true">
    <img src="{{ 'kalpa-can-original.webp' | asset_url }}" alt="" class="nosotros-hero__can" width="440" height="960" draggable="false">
    <span class="nosotros-hero__can-shadow"></span>
  </div>

  <div class="nosotros-hero__container">
    <!-- Subtítulos superiores con línea -->
    <div class="nosotros-hero__top">
      <span class="nosotros-hero__subtitle nosotros-hero__subtitle--left">{{ section.settings.hero_sub_left | default: 'CAFÉ DE ALTURA' }}</span>
      <span class="nosotros-hero__subtitle nosotros-hero__subtitle--right">{{ section.settings.hero_sub_right | default: 'VRAEM' }}</span>
    </div>

    <!-- Palabras gigantes a ambos lados de la lata -->
    <h1 class="nosotros-hero__headline">
      <span class="nosotros-hero__giant-word nosotros-hero__giant-word--white">{{ section.settings.hero_title_left | default: 'ENERGÍA' }}</span>
      <span class="nosotros-hero__giant-word nosotros-hero__giant-word--gold">{{ section.settings.hero_title_right | default: 'NATURAL' }}</span>
    </h1>

    <!-- CTA inferior -->
    <div class="nosotros-hero__bottom-row">
      <a href="#origen-ayacucho" class="btn-hero-descubre">
        <span>DESCUBRE KALPA</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>

  <!-- Indicador lateral -->
  <nav class="nosotros-hero__steps" aria-label="Secciones">
    <a href="#origen-ayacucho" class="is-active">01</a>
    <a href="#origen-ayacucho">02</a>
    <a href="#como-lo-hacemos">03</a>
  </nav>
</section>
<script>
  (function () {
    // El hero ocupa exactamente la pantalla visible debajo de la barra de anuncios y el menú
    var hero = document.querySelector(".nosotros-hero");
    if (!hero) return;
    var setOffset = function () {
      var top = hero.getBoundingClientRect().top + window.scrollY;
      document.documentElement.style.setProperty("--nosotros-hero-offset", top + "px");
    };
    setOffset();
    window.addEventListener("resize", setOffset);
  })();
</script>

<!-- ==================== 4–8. HISTORIA KALLPA: RAÍZ · CÓMO · POR QUÉ · GENTE · PRUÉBALA ==================== -->
<div class="nos-story">

  <!-- 03 · LA RAÍZ DE KALLPA -->
  <section class="nos-block nos-raiz" id="origen-ayacucho">
    <img src="{{ 'nos-hoja-1.webp' | asset_url }}" alt="" class="nos-deco nos-raiz__leaf" loading="lazy" aria-hidden="true">
    <div class="nos-block__inner">
      <div class="nos-block__text">
        <span class="nos-eyebrow">NUESTRO<br>ORIGEN</span>
        <h2 class="nos-title">LA RAÍZ<br><em>DE KALLPA</em></h2>
        <p>Ayacucho no es solo de donde viene el café. Es el origen, la cultura y la razón de ser de lo que hacemos. Creemos que los insumos andinos merecen ser reconocidos, y empezamos por el café.</p>
        <div class="nos-marca">
          {%- if section.settings.marca_ayacucho_logo != blank -%}
            <img src="{{ section.settings.marca_ayacucho_logo | image_url: width: 240 }}" alt="Marca Ayacucho, donde nace el Perú" class="nos-marca__logo" width="104" height="104" loading="lazy">
          {%- else -%}
            <img src="{{ 'marca-ayacucho.webp' | asset_url }}" alt="Marca Ayacucho, donde nace el Perú" class="nos-marca__logo" width="104" height="104" loading="lazy">
          {%- endif -%}
          <p>Por eso somos orgullosos embajadores de la Marca Ayacucho, que promueve la identidad cultural de nuestra región y la lleva al Perú y al mundo.</p>
        </div>
        <a href="#como-lo-hacemos" class="nos-btn nos-btn--outline">CÓMO LO HACEMOS <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg></a>
      </div>
      <figure class="nos-raiz__visual">
        <img src="{{ 'nos-raiz-collage.webp' | asset_url }}" alt="Ayacucho entre montañas y cafetales" loading="lazy" width="1672" height="941">
        <figcaption class="nos-raiz__tag">Ayacucho<br>Perú</figcaption>
      </figure>
    </div>
  </section>

  <!-- 04 · CÓMO LO HACEMOS -->
  <section class="nos-block nos-como" id="como-lo-hacemos">
    <img src="{{ 'nos-hoja-3.webp' | asset_url }}" alt="" class="nos-deco nos-como__leaf" loading="lazy" aria-hidden="true">
    <div class="nos-block__inner nos-block__inner--reverse">
      <figure class="nos-como__visual">
        <img src="{{ 'nos-manos-cerezas.webp' | asset_url }}" alt="Manos de productor con cerezas de café recién cosechadas" loading="lazy" width="1536" height="1024">
      </figure>
      <div class="nos-block__text">
        <span class="nos-eyebrow">CÓMO LO HACEMOS</span>
        <h2 class="nos-title">DEL CAFETAL<br><em>A TU LATA</em></h2>
        <ul class="nos-stats nos-stats--2col">
          <li><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 20 6.5-11 4 6.5 2.5-4L21 20z"></path><path d="m8 11.5 1.5 1.5 1.5-1.5"></path></svg><span><small>ALTURA</small>1,650 msnm</span></li>
          <li><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20c-4 0-7-3-7-7 0-4.5 3.5-8 7-8s7 3.5 7 8c0 4-3 7-7 7z"></path><path d="M12 5c-1.5 3-1.5 8 0 15"></path></svg><span><small>SELECCIÓN</small>Grano a grano, por productores ayacuchanos</span></li>
          <li><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v10"></path><path d="m9 5 3 2 3-2"></path><path d="m9 9 3 2 3-2"></path><path d="M6 14h12l-1.5 7h-9z"></path></svg><span><small>EXTRACCIÓN</small>16 horas en frío</span></li>
          <li><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="7" y="4" width="10" height="17" rx="2"></rect><path d="M9 4V2.5h6V4"></path><path d="M7 9h10"></path><path d="M7 16h10"></path></svg><span><small>ENVASADO</small>Pasteurizado y enlatado, sin conservantes</span></li>
        </ul>
        <ul class="nos-features">
          <li><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m13 6-4 7h4l-2 5"></path></svg><strong>CAFEÍNA REAL</strong><span>280 mg que vienen del propio café.</span></li>
          <li><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><ellipse cx="12" cy="12" rx="4" ry="5.5" transform="rotate(30 12 12)"></ellipse><path d="M10 8.5c2 1.5 2 5.5 4 7"></path></svg><strong>SABOR DE ALTURA</strong><span>Más cuerpo y menos acidez, gracias a la extracción en frío.</span></li>
          <li><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M8 16c0-5 3-8 8-8 0 5-3 8-8 8z"></path><path d="M8 16l5-5"></path></svg><strong>SIN SACRIFICAR TU CUERPO</strong><span>0 azúcar, 0 saborizantes y 0 conservantes.</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 05 · POR QUÉ EXISTIMOS -->
  <section class="nos-block nos-porque" id="por-que-existimos">
    <div class="nos-block__inner">
      <div class="nos-block__text">
        <span class="nos-eyebrow">POR QUÉ EXISTIMOS</span>
        <h2 class="nos-title">LIBERAR EL<br><em>MÁXIMO POTENCIAL<br>DE TU CUERPO</em></h2>
        <p>Creemos en un mundo donde no tengas que elegir entre rendir ahora y cuidarte después. Tu cuerpo merece algo mejor.</p>
      </div>
      <figure class="nos-porque__visual">
        <img src="{{ 'nos-porque-aventura.webp' | asset_url }}" alt="Montañista bebiendo KALPA Cold Brew en los Andes" loading="lazy" width="1672" height="941">
      </figure>
    </div>
  </section>

  <!-- 06 · LA GENTE DETRÁS DEL CAFÉ -->
  <section class="nos-block nos-gente" id="la-gente">
    <img src="{{ 'nos-hojas-grupo.webp' | asset_url }}" alt="" class="nos-deco nos-gente__leaf" loading="lazy" aria-hidden="true">
    <div class="nos-block__inner">
      <div class="nos-block__text">
        <span class="nos-eyebrow">QUIÉNES SOMOS</span>
        <h2 class="nos-title">LA GENTE<br><em>DETRÁS DE KALPA</em></h2>
        <p>Los que la cultivan, los que la crean y los que la viven.</p>
        <a href="#cta-helada" class="nos-btn nos-btn--outline">CONOCE MÁS <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>
      </div>
      <div class="nos-gente__cards">
        <figure class="nos-card">
          <img src="{{ 'product-card-molido-250.webp' | asset_url }}" alt="Productores de café de Ayacucho" loading="lazy">
          <figcaption>Nuestros<br>productores</figcaption>
        </figure>
        <figure class="nos-card">
          <img src="{{ 'vraem-harvest.webp' | asset_url }}" alt="Equipo Kalpa" loading="lazy">
          <figcaption>Equipo<br>Kalpa</figcaption>
        </figure>
        <figure class="nos-card">
          <img src="{{ 'energy-natural-composition.webp' | asset_url }}" alt="Comunidad Kalpa" loading="lazy">
          <figcaption>Nuestra<br>comunidad</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 07 · PRUÉBALA BIEN HELADA -->
  <section class="nos-block nos-pruebala" id="cta-helada">
    <img src="{{ 'nos-cerezas-rama.webp' | asset_url }}" alt="" class="nos-deco nos-pruebala__cherries" loading="lazy" aria-hidden="true">
    <div class="nos-block__inner">
      <div class="nos-block__text">
        <span class="nos-eyebrow">NUESTRO CAFÉ</span>
        <h2 class="nos-title">PRUÉBALA<br><em>BIEN HELADA</em></h2>
        <p>Siente la energía de los Andes en cada lata.<br>Un café potente, limpio y natural, hecho para acompañarte en cada reto.</p>
        <a href="{{ routes.all_products_collection_url }}" class="nos-btn nos-btn--gold">ELEGIR MI PACK <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>
      </div>
      <figure class="nos-pruebala__visual">
        <span class="nos-pruebala__tag">Energía<br>Natural</span>
        <img src="{{ 'nos-pruebala-splash.webp' | asset_url }}" alt="Lata KALPA Cold Brew con hielo y granos de café" loading="lazy" width="1672" height="941">
      </figure>
    </div>
  </section>

</div>

{% schema %}
{
  "name": "Historia & Manifiesto",
  "settings": [
    {
      "type": "image_picker",
      "id": "marca_ayacucho_logo",
      "label": "Logo Marca Ayacucho"
    },
    {
      "type": "text",
      "id": "hero_sub_left",
      "label": "Hero Subtítulo Izquierdo",
      "default": "CAFÉ DE ALTURA"
    },
    {
      "type": "text",
      "id": "hero_title_left",
      "label": "Hero Título Izquierdo",
      "default": "ENERGÍA"
    },
    {
      "type": "text",
      "id": "hero_sub_right",
      "label": "Hero Subtítulo Derecho",
      "default": "VRAEM"
    },
    {
      "type": "text",
      "id": "hero_title_right",
      "label": "Hero Título Derecho",
      "default": "NATURAL"
    },
    {
      "type": "text",
      "id": "energia_kicker",
      "label": "Energía Kicker",
      "default": "ORIGEN Y SIGNIFICADO"
    },
    {
      "type": "text",
      "id": "energia_title",
      "label": "Energía Título",
      "default": "ENERGÍA DE LOS ANDES"
    },
    {
      "type": "textarea",
      "id": "energia_quote",
      "label": "Energía Cita",
      "default": "Kalpa significa fuerza, energía y poder en quechua."
    },
    {
      "type": "textarea",
      "id": "energia_body",
      "label": "Energía Cuerpo",
      "default": "Nació para que rindas al máximo sin sacrificar tu cuerpo. Una bebida creada a partir de café de especialidad de origen peruano, con cafeína limpia que estimula tu mente y cuerpo de forma continua y natural."
    },
    {
      "type": "text",
      "id": "raiz_kicker",
      "label": "Raíz Kicker",
      "default": "LA RAÍZ DE KALPA"
    },
    {
      "type": "text",
      "id": "raiz_title",
      "label": "Raíz Título",
      "default": "AYACUCHO"
    },
    {
      "type": "textarea",
      "id": "raiz_lead",
      "label": "Raíz Lead",
      "default": "Ayacucho no es solo de donde viene el café. Es el origen, la cultura y la razón de ser de lo que hacemos."
    },
    {
      "type": "textarea",
      "id": "raiz_text",
      "label": "Raíz Texto",
      "default": "Usamos la energía natural de los insumos andinos: potente, limpia, sin artificios. Insumos andinos que merecen ser reconocidos en el Perú y en el mundo entero por su calidad insuperable."
    }
  ],
  "presets": [
    {
      "name": "Historia & Manifiesto"
    }
  ]
}
{% endschema %}
