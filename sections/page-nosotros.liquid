{%- comment -%}
  SECCIÓN: page-nosotros.liquid
  Página de Historia, Origen VRAEM y Manifiesto KALPA (Pixel-Perfect con nosotros.html)
{%- endcomment -%}

<!-- 1. HERO NOSOTROS: EL ARCO ANDINO -->
<section class="nosotros-hero" aria-label="Hero Nosotros">
  <div class="nosotros-hero__bg" aria-hidden="true"></div>
  <div class="nosotros-hero__arch" aria-hidden="true"></div>
  <div class="nosotros-hero__vignette" aria-hidden="true"></div>

  <!-- Lata flotando recta sobre la roca, dentro del arco de luz -->
  <div class="nosotros-hero__can-wrap" aria-hidden="true">
    <img src="{{ 'kalpa-can-original.png' | asset_url }}" alt="" class="nosotros-hero__can" width="440" height="960" draggable="false">
    <span class="nosotros-hero__can-shadow"></span>
  </div>

  <div class="nosotros-hero__container">
    <!-- Subtítulos superiores con línea -->
    <div class="nosotros-hero__top">
      <span class="nosotros-hero__subtitle nosotros-hero__subtitle--left">{{ section.settings.hero_sub_left | default: 'CAFÉ DE ALTURA' }}</span>
      <span class="nosotros-hero__subtitle nosotros-hero__subtitle--right">{{ section.settings.hero_sub_right | default: 'VRAEM' }}</span>
    </div>

    <!-- Palabras gigantes a ambos lados de la lata -->
    <h1 class="nosotros-hero__headline">
      <span class="nosotros-hero__giant-word nosotros-hero__giant-word--white">{{ section.settings.hero_title_left | default: 'ENERGÍA' }}</span>
      <span class="nosotros-hero__giant-word nosotros-hero__giant-word--gold">{{ section.settings.hero_title_right | default: 'NATURAL' }}</span>
    </h1>

    <!-- CTA inferior -->
    <div class="nosotros-hero__bottom-row">
      <a href="#origen-ayacucho" class="btn-hero-descubre">
        <span>DESCUBRE KALPA</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>

  <!-- Indicador lateral -->
  <nav class="nosotros-hero__steps" aria-label="Secciones">
    <a href="#origen-ayacucho" class="is-active">01</a>
    <a href="#origen-ayacucho">02</a>
    <a href="#como-lo-hacemos">03</a>
  </nav>
</section>
<script>
  (function () {
    // El hero ocupa exactamente la pantalla visible debajo de la barra de anuncios y el menú
    var hero = document.querySelector(".nosotros-hero");
    if (!hero) return;
    var setOffset = function () {
      var top = hero.getBoundingClientRect().top + window.scrollY;
      document.documentElement.style.setProperty("--nosotros-hero-offset", top + "px");
    };
    setOffset();
    window.addEventListener("resize", setOffset);
  })();
</script>

<!-- ==================== 4–8. HISTORIA KALLPA: RAÍZ · CÓMO · POR QUÉ · GENTE · PRUÉBALA ==================== -->
<div class="nos-story">

  <!-- 03 · LA RAÍZ DE KALLPA -->
  <section class="nos-block nos-raiz" id="origen-ayacucho">
    <img src="{{ 'nos-hoja-1.png' | asset_url }}" alt="" class="nos-deco nos-raiz__leaf" loading="lazy" aria-hidden="true">
    <div class="nos-block__inner">
      <span class="nos-step">03</span>
      <div class="nos-block__text">
        <span class="nos-eyebrow">NUESTRO<br>ORIGEN</span>
        <h2 class="nos-title">LA RAÍZ<br><em>DE KALLPA</em></h2>
        <p>Ayacucho no es solo de donde viene el café.<br>Es el origen, la cultura y la razón de ser de lo que hacemos.</p>
        <p>Usamos la energía natural de los insumos andinos: potente, limpia, sin artificios.</p>
        <p>Insumos andinos que merecen ser reconocidos.</p>
        <a href="#como-lo-hacemos" class="nos-btn nos-btn--outline">CONOCE AYACUCHO <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>
      </div>
      <figure class="nos-raiz__visual">
        <img src="{{ 'nos-raiz-collage.png' | asset_url }}" alt="Ayacucho entre montañas y cafetales" loading="lazy" width="1672" height="941">
        <figcaption class="nos-raiz__tag">Ayacucho<br>Perú</figcaption>
      </figure>
    </div>
  </section>

  <!-- 04 · CÓMO LO HACEMOS -->
  <section class="nos-block nos-como" id="como-lo-hacemos">
    <img src="{{ 'nos-hoja-3.png' | asset_url }}" alt="" class="nos-deco nos-como__leaf" loading="lazy" aria-hidden="true">
    <div class="nos-block__inner nos-block__inner--reverse">
      <figure class="nos-como__visual">
        <img src="{{ 'nos-manos-cerezas.webp' | asset_url }}" alt="Manos de productor con cerezas de café recién cosechadas" loading="lazy" width="1536" height="1024">
      </figure>
      <div class="nos-block__text">
        <span class="nos-eyebrow">CÓMO LO HACEMOS</span>
        <h2 class="nos-title">POTENTE,<br>LIMPIA,<br><em>SIN ARTIFICIOS</em></h2>
        <ul class="nos-stats">
          <li><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 20 6.5-11 4 6.5 2.5-4L21 20z"></path><path d="m8 11.5 1.5 1.5 1.5-1.5"></path></svg><span><small>ALTURA</small>1,800 – 2,200 msnm</span></li>
          <li><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21V9"></path><path d="M12 13c-3 0-5-2-5-5 3 0 5 2 5 5z"></path><path d="M12 10c0-3 2-5 5-5 0 3-2 5-5 5z"></path><path d="M12 17c-2.5 0-4-1.5-4-4 2.5 0 4 1.5 4 4z"></path></svg><span><small>COSECHA</small>Abril – Agosto</span></li>
          <li><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="7" r="2.5"></circle><circle cx="16" cy="7" r="2.5"></circle><path d="M3.5 20v-3.5A3.5 3.5 0 0 1 7 13h2a3.5 3.5 0 0 1 3.5 3.5V20"></path><path d="M11.5 20v-3.5A3.5 3.5 0 0 1 15 13h2a3.5 3.5 0 0 1 3.5 3.5V20"></path></svg><span><small>ORIGEN CON PRODUCTORES</small>de Ayacucho</span></li>
        </ul>
        <ul class="nos-features">
          <li><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m13 6-4 7h4l-2 5"></path></svg><strong>CAFEÍNA REAL</strong><span>Cafeína de la tierra, no de laboratorio.</span></li>
          <li><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><ellipse cx="12" cy="12" rx="4" ry="5.5" transform="rotate(30 12 12)"></ellipse><path d="M10 8.5c2 1.5 2 5.5 4 7"></path></svg><strong>CAFÉ DE VERDAD</strong><span>Sin fórmulas que no entiendes.</span></li>
          <li><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M8 16c0-5 3-8 8-8 0 5-3 8-8 8z"></path><path d="M8 16l5-5"></path></svg><strong>SIN SACRIFICAR TU CUERPO</strong><span>0 calorías, 0 saborizantes y 0 conservantes.</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 05 · POR QUÉ EXISTIMOS -->
  <section class="nos-block nos-porque" id="por-que-existimos">
    <div class="nos-block__inner">
      <span class="nos-step">04</span>
      <div class="nos-block__text">
        <span class="nos-eyebrow">POR QUÉ EXISTIMOS</span>
        <h2 class="nos-title">LIBERAR EL<br><em>MÁXIMO POTENCIAL<br>DE TU CUERPO</em></h2>
        <p>Café de altura de Ayacucho.<br>Un origen que puedes señalar en el mapa y una razón de ser.</p>
        <p>Tu cuerpo merece algo mejor.</p>
      </div>
      <figure class="nos-porque__visual">
        <img src="{{ 'nos-porque-aventura.png' | asset_url }}" alt="Montañista bebiendo KALPA Cold Brew en los Andes" loading="lazy" width="1672" height="941">
        <ul class="nos-zero-list">
          <li><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2"></rect><line x1="4" y1="20" x2="20" y2="4"></line></svg>Sin azúcar</li>
          <li><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"></path><text x="12" y="17" font-size="7" text-anchor="middle" fill="currentColor" stroke="none" font-family="sans-serif">0</text></svg>0 calorías</li>
          <li><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6"></path><path d="M10 3v6l-5 9a2 2 0 0 0 1.7 3h10.6a2 2 0 0 0 1.7-3l-5-9V3"></path><line x1="4" y1="20" x2="20" y2="4"></line></svg>0 saborizantes</li>
          <li><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 5 6v6c0 4 3 7 7 9 4-2 7-5 7-9V6z"></path><line x1="5" y1="19" x2="19" y2="5"></line></svg>0 conservantes</li>
        </ul>
      </figure>
    </div>
  </section>

  <!-- 06 · LA GENTE DETRÁS DEL CAFÉ -->
  <section class="nos-block nos-gente" id="la-gente">
    <img src="{{ 'nos-hojas-grupo.png' | asset_url }}" alt="" class="nos-deco nos-gente__leaf" loading="lazy" aria-hidden="true">
    <div class="nos-block__inner">
      <span class="nos-step">05</span>
      <div class="nos-block__text">
        <span class="nos-eyebrow">LA GENTE DETRÁS DEL CAFÉ</span>
        <h2 class="nos-title">LAS PERSONAS<br><em>SIN SACRIFICAR<br>SU CUERPO</em></h2>
        <p>Creemos en un mundo donde puedas liberar tu máximo potencial sin sacrificar tu cuerpo, con insumos andinos que merecen ser reconocidos.</p>
        <a href="#cta-helada" class="nos-btn nos-btn--outline">CONOCE MÁS <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>
      </div>
      <div class="nos-gente__cards">
        <figure class="nos-card">
          <img src="{{ 'product-card-molido-250.jpg' | asset_url }}" alt="Productores de café de Ayacucho" loading="lazy">
          <figcaption>Productores<br>de Ayacucho</figcaption>
        </figure>
        <figure class="nos-card">
          <img src="{{ 'vraem-harvest.jpg' | asset_url }}" alt="Cerezas de café recién cosechadas" loading="lazy">
          <figcaption>Del cafetal<br>a tu lata</figcaption>
        </figure>
        <figure class="nos-card">
          <img src="{{ 'energy-natural-composition.png' | asset_url }}" alt="Equipo Kallpa" loading="lazy">
          <figcaption>Equipo<br>Kallpa</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 07 · PRUÉBALA BIEN HELADA -->
  <section class="nos-block nos-pruebala" id="cta-helada">
    <img src="{{ 'nos-cerezas-rama.png' | asset_url }}" alt="" class="nos-deco nos-pruebala__cherries" loading="lazy" aria-hidden="true">
    <div class="nos-block__inner">
      <span class="nos-step">06</span>
      <div class="nos-block__text">
        <span class="nos-eyebrow">NUESTRO CAFÉ</span>
        <h2 class="nos-title">PRUÉBALA<br><em>BIEN HELADA</em></h2>
        <p>Siente la energía de los Andes en cada lata.<br>Un café potente, limpio y natural, hecho para acompañarte en cada reto.</p>
        <a href="{{ routes.all_products_collection_url }}" class="nos-btn nos-btn--gold">ELEGIR MI PACK <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>
      </div>
      <figure class="nos-pruebala__visual">
        <span class="nos-pruebala__tag">Energía<br>Natural</span>
        <img src="{{ 'nos-pruebala-splash.png' | asset_url }}" alt="Lata KALPA Cold Brew con hielo y granos de café" loading="lazy" width="1672" height="941">
      </figure>
    </div>
  </section>

</div>

