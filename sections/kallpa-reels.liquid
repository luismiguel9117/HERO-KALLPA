              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
            <span>87K</span>
          </div>
        </div>
      </div>

      <!-- Reel 5 -->
      <div class="reel-card" onclick="alert('Abriendo Reel KALPA en Instagram...')">
        <img src="{{ 'reel-5.jpg' | asset_url }}" alt="KALPA Reel 5" class="reel-card__img" loading="lazy" width="300" height="533" />
        <div class="reel-card__overlay">
          <div class="reel-play-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
          </div>
          <div class="reel-views">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
            <span>320K</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Reels KALPA",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "COMUNIDAD KALPA"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "NUESTROS REELS"
    }
  ]
}
{% endschema %}
