    {%- for i in (1..6) -%}
      <div class="ticker-item">
        <span class="highlight">⚡ KALLPA VITALITY</span>
        <span>•</span>
        <span>RENDIMIENTO CELULAR 3D</span>
        <span>•</span>
        <span class="highlight">EXTRACTOS ANDINOS</span>
        <span>•</span>
        <span>CERO CAÍDA DE ENERGÍA</span>
        <span>•</span>
        <span class="highlight">60 FPS PERFORMANCE</span>
        <span>•</span>
      </div>
    {%- endfor -%}
  </div>
</div>

