{%- comment -%}
  SNIPPET: pdp-media.liquid
  Un elemento de la galería de la ficha de producto (main-product.liquid).
  Sirve igual para un archivo de metacampo (custom.ficha_N) que para un medio del producto.

  Parámetros:
  - file: archivo o medio (imagen, GIF, video de Shopify o archivo genérico)
  - index: posición en la galería (0 = portada)
  - mode: 'slide' (escenario) o 'thumb' (miniatura)
  - title: texto alternativo por defecto
{%- endcomment -%}

{%- liquid
  assign file_url = file.url | default: file.src
  assign file_ext = file_url | split: '?' | first | split: '.' | last | downcase
  assign is_video = false
  if file.media_type == 'video' or file_ext == 'mp4' or file_ext == 'webm' or file_ext == 'mov'
    assign is_video = true
  endif
  # Video externo (YouTube/Vimeo) o modelo 3D: se muestra su imagen de vista previa
  assign use_preview = false
  if file.media_type == 'external_video' or file.media_type == 'model'
    assign use_preview = true
  endif
-%}

{%- if mode == 'thumb' -%}
  {%- liquid
    assign thumb_src = ''
    if file.media_type == 'image'
      assign thumb_src = file | image_url: width: 160
    elsif file.preview_image != blank
      assign thumb_src = file.preview_image | image_url: width: 160
    elsif is_video == false
      assign thumb_src = file_url
    endif
  -%}
  <button type="button" class="pdp-thumb{% if is_video %} pdp-thumb--video{% endif %}{% if index == 0 %} is-active{% endif %}" onclick="showProductSlide({{ index }}, this)" aria-label="{% if is_video %}Ver video{% else %}Ver imagen {{ index | plus: 1 }}{% endif %}">
    {%- if thumb_src != blank -%}<img src="{{ thumb_src }}" alt="" width="78" height="92" loading="lazy">{%- endif -%}
    {%- if is_video -%}<span class="pdp-thumb__play" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>{%- endif -%}
  </button>
{%- else -%}
  {%- comment -%} La portada llena el escenario (las miniaturas quedan encima); las demás se ven completas, a la derecha de las miniaturas {%- endcomment -%}
  {%- assign alt_text = file.alt | default: title | escape -%}
  <div class="pdp-slide{% if index == 0 %} pdp-slide--cover is-active{% endif %}" data-slide="{{ index }}">
    {%- if is_video -%}
      {%- if file.media_type == 'video' -%}
        {%- assign video_src = file.sources | where: 'format', 'mp4' | first | map: 'url' | first | default: file.sources.first.url -%}
        {%- assign poster = file.preview_image | image_url: width: 1600 -%}
      {%- else -%}
        {%- assign video_src = file_url -%}
        {%- assign poster = '' -%}
      {%- endif -%}
      <video class="pdp-stage__img pdp-stage__video" src="{{ video_src }}"{% if poster != blank %} poster="{{ poster }}"{% endif %} muted loop playsinline controls preload="{% if index == 0 %}auto{% else %}none{% endif %}"{% if index == 0 %} autoplay{% endif %}></video>
    {%- elsif file.media_type == 'image' or use_preview -%}
      {%- if use_preview -%}{%- assign image_source = file.preview_image -%}{%- else -%}{%- assign image_source = file -%}{%- endif -%}
      <img src="{{ image_source | image_url: width: 600 }}" alt="" class="pdp-stage__backdrop" aria-hidden="true" width="600" height="600"{% if index > 0 %} loading="lazy"{% endif %}>
      <img src="{{ image_source | image_url: width: 1600 }}" alt="{{ alt_text }}" class="pdp-stage__img" width="1600" height="1600"{% if index == 0 %} fetchpriority="high"{% else %} loading="lazy"{% endif %}>
    {%- else -%}
      <img src="{{ file_url }}" alt="" class="pdp-stage__backdrop" aria-hidden="true" width="600" height="600"{% if index > 0 %} loading="lazy"{% endif %}>
      <img src="{{ file_url }}" alt="{{ alt_text }}" class="pdp-stage__img" width="1600" height="1600"{% if index > 0 %} loading="lazy"{% endif %}>
    {%- endif -%}
  </div>
{%- endif -%}
