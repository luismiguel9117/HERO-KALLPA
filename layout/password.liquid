<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'es' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }} &ndash; Próximamente</title>
    {{ content_for_header }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
  </head>
  <body style="display: flex; align-items: center; justify-content: center; min-height: 100vh; background: var(--bg-primary); text-align: center; padding: 2rem;">
    <div style="max-width: 500px;">
